          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de changer de fenêtre. L’app n’a peut-être qu’une seule fenêtre ou ne prend pas cela en charge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось переключить окно. Возможно, у приложения только одно окно или оно это не поддерживает."
          }
        }
      }
    },
    "windowCycleHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt nacheinander durch die geöffneten Fenster der App im Vordergrund. Minimierte Fenster und Tabs werden übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves through the open windows of the app in front, one at a time. Minimized windows and tabs are skipped."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe d’une fenêtre ouverte à l’autre dans l’app au premier plan. Les fenêtres réduites et les onglets sont ignorés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По очереди переключает открытые окна приложения на переднем плане. Свёрнутые окна и вкладки пропускаются."
          }
        }
      }
    },
    "windowLayoutFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster konnte nicht verschoben werden. Beenden Sie zuerst den Vollbildmodus; manche Apps begrenzen außerdem Größe oder Position ihrer Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not move the window. Leave full screen first; some apps also limit the size or position of their windows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déplacer la fenêtre. Quittez d’abord le plein écran ; certaines apps limitent aussi la taille ou la position de leurs fenêtres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось переместить окно. Сначала выйдите из полноэкранного режима; кроме того, некоторые приложения ограничивают размер и положение своих окон."
          }
        }
      }
    },
    "windowLayoutHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platziert das Fenster im Vordergrund auf seinem aktuellen Display und lässt Dock und Menüleiste frei. Funktioniert nicht im Vollbildmodus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the window in front on its current display, leaving room for the Dock and menu bar. It does not work in full screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place la fenêtre au premier plan sur son écran actuel, sans recouvrir le Dock ni la barre des menus. Ne fonctionne pas en plein écran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размещает окно на переднем плане в пределах его экрана, не перекрывая Dock и строку меню. В полноэкранном режиме не работает."
          }
        }
      }
    },
    "workspaceActionFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das konnte nicht geöffnet werden. Prüfen Sie, ob die App oder Datei noch vorhanden ist und ob es für die Adresse oder Datei eine Standard-App gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not open this. Check that the app or file still exists and that the address or file has a default app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir cet élément. Vérifiez que l’app ou le fichier existe toujours et qu’une app par défaut peut ouvrir l’adresse ou le fichier."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось это открыть. Проверьте, что приложение или файл на месте и что для адреса или файла есть приложение по умолчанию."
          }
        }
      }
