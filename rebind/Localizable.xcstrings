    },
    "trackpadSystemGestureHelp" : {
      "comment" : "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS reagiert möglicherweise ebenfalls auf diese Geste. Prüfen Sie in diesem Fall die Gesten unter Systemeinstellungen → Trackpad oder wählen Sie eine andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS may respond to this gesture too. If it does, review the gestures in System Settings → Trackpad or choose another one."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS peut aussi réagir à ce geste. Dans ce cas, vérifiez les gestes dans Réglages Système → Trackpad ou choisissez-en un autre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS тоже может реагировать на этот жест. Если так и происходит, проверьте жесты в разделе «Системные настройки» → «Трекпад» или выберите другой жест."
          }
        }
      }
    },
    "trackpadSystemGestureWarning" : {
      "comment" : "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS reagiert möglicherweise ebenfalls"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS may respond too"
          }
        },
        "fr" : {
