    "appleShortcutFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kurzbefehl ist fehlgeschlagen oder hat länger als 60 Sekunden gedauert. Prüfen Sie ihn und seine Berechtigungen in der App „Kurzbefehle“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shortcut failed or took longer than 60 seconds. Check it and its permissions in the Shortcuts app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci a échoué ou a duré plus de 60 secondes. Vérifiez-le, ainsi que ses autorisations, dans l’app Raccourcis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда завершилась с ошибкой или выполнялась дольше 60 секунд. Проверьте её и её разрешения в приложении «Команды»."
          }
        }
      }
    },
    "appleShortcutHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt den gewählten Kurzbefehl aus, ohne Text, Dateien oder die Zwischenablage zu übergeben. Er darf bis zu 60 Sekunden laufen; andere Aktionen warten so lange. Benötigte Berechtigungen fragt die App „Kurzbefehle“ selbst an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs the selected shortcut without passing it any text, files or clipboard content. It can run for up to 60 seconds, and other actions wait until it finishes. The Shortcuts app asks for any permissions it needs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute le raccourci choisi sans lui transmettre de texte, de fichiers ni le presse-papiers. Il peut durer jusqu’à 60 secondes ; les autres actions attendent sa fin. L’app Raccourcis demande elle-même les autorisations nécessaires."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает выбранную команду, не передавая ей текст, файлы или буфер обмена. Команда может выполняться до 60 секунд; остальные действия ждут её завершения. Нужные разрешения запрашивает приложение «Команды»."
          }
        }
      }
    },
