    "wheelMappingHint": {
      "comment": "Limits apply to discrete line-based scroll events, globally across wheel rules. No physical device attribution is claimed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diskrete Mausradereignisse; insgesamt bis zu 10 Tastenkombinationen pro Sekunde für Mausradbelegungen. Sanftes, träges und diagonales Scrollen bleibt erhalten. Richtungen folgen macOS-Einstellungen; umgewandelte Ereignisse können ebenfalls passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discrete wheel events only; up to 10 shortcuts per second across wheel rules. Smooth, momentum and diagonal scrolling pass through. Directions follow macOS settings; converted events can also match."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Événements discrets de molette uniquement ; jusqu’à 10 raccourcis par seconde pour l’ensemble des règles de molette. Le défilement fluide, inertiel et diagonal est conservé. Les directions suivent les réglages macOS ; les événements convertis peuvent aussi correspondre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только дискретная прокрутка: до 10 сочетаний в секунду суммарно для правил колеса. Плавная, инерционная и диагональная прокрутка сохраняются. Направления зависят от настроек macOS; преобразованные события тоже могут совпадать."
          }
        }
      }
    },
