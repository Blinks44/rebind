    "advancedStaleReviewBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration changed while this replacement was being reviewed. Nothing was replaced. Choose the backup or reset again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфигурация изменилась во время проверки. Замена не выполнена. Выберите копию или повторите сброс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration wurde während der Prüfung geändert. Nichts wurde ersetzt. Backup erneut wählen oder Zurücksetzen wiederholen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration a changé pendant la vérification. Rien n’a été remplacé. Choisissez à nouveau la copie ou relancez la réinitialisation."
          }
        }
      }
    },
    "advancedValidationDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validating backup… No changes have been applied. Configuration actions are unavailable until validation finishes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка копии… Данные не изменены. Действия с конфигурацией станут доступны после проверки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup wird geprüft… Es wurde nichts geändert. Konfigurationsaktionen sind nach der Prüfung wieder verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de la copie… Rien n’a changé. Les actions de configuration seront disponibles après la vérification."
          }
        }
      }
    },
    "advancedValidationResetDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
