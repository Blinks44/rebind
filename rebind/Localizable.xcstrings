    "doubleLeftClickAction": {
      "comment": "Mouse output action/category or execution contract; not a physical trigger.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double left click"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойной левый клик"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
