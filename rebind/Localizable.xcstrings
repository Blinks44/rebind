    "advancedDiagnosticsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maustasten und Scrollen prüfen. Die Aufzeichnung bleibt im Speicher und endet nach 60 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspect mouse buttons and scroll events. Recording stays in memory and stops after 60 seconds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les boutons et le défilement. L’enregistrement reste en mémoire et s’arrête après 60 secondes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка кнопок и прокрутки. Запись хранится в памяти и длится не более 60 секунд."
          }
        }
      }
    },
