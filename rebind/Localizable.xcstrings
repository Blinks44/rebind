    "eventSendingPurpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen sind aktiviert. macOS benötigt noch die Erlaubnis, Tastenkombinationen und Klicks an andere Apps zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility is on. Rebind still needs permission to send shortcuts and clicks to other apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accessibilité est activée. macOS a encore besoin d’une autorisation pour envoyer des raccourcis et clics aux autres apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ включён. Rebind ещё нужно разрешение отправлять сочетания клавиш и щелчки в другие приложения."
          }
        }
      }
    },
    "eventSendingSteps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls der Zugriff weiterhin fehlt, prüfen Sie Rebind unter „Bedienungshilfen“. Beenden und öffnen Sie Rebind erneut, wenn macOS Sie dazu auffordert."
          }
        },
        "en" : {
          "stringUnit" : {
