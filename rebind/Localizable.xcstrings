    "privacyAssurance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rules stay on this Mac. Rebind does not save typed text or passwords."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши правила остаются на этом Mac. Rebind не сохраняет вводимый текст и пароли."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Regeln bleiben auf diesem Mac. Rebind speichert weder eingegebenen Text noch Passwörter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos règles restent sur ce Mac. Rebind n’enregistre ni le texte saisi ni les mots de passe."
          }
        }
      }
    },
