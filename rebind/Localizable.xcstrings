          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Profile und Belegungen entfernen und App-Einstellungen zurücksetzen. Zuerst ein Backup erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime tous les profils et les associations et rétablit les réglages de l’app. Exportez d’abord une copie."
          }
        }
      }
    },
