        }
      }
    },
    "diagnosticsLimits": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 128 Einträge, 20 pro Sekundenfenster, 60 Sekunden pro Sitzung. Nur im Speicher; Schließen, Ruhezustand, sichere Eingabe oder Zugriffsverlust stoppen die Erfassung und löschen die Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 128 entries, 20 per one-second window, 60 seconds per session. Memory only; closing, sleep, Secure Input or loss of access stops collection and clears the data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 128 entrées, 20 par fenêtre d’une seconde, 60 secondes par session. En mémoire uniquement ; fermeture, veille, saisie sécurisée ou perte d’accès arrêtent la collecte et effacent les données."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 128 записей, 20 за секундное окно, 60 секунд на сеанс. Только в памяти; закрытие, сон, защищённый ввод или потеря доступа останавливают сбор и очищают данные."
          }
        }
      }
    },
