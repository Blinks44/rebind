    "permissionsRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility and Input Monitoring permissions are required."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны разрешения «Универсальный доступ» и «Мониторинг ввода»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Bedienungshilfen und Eingabeüberwachung erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations Accessibilité et Surveillance de l’entrée sont requises."
          }
        }
      }
    },
