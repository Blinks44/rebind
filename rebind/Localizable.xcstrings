    "recordingLimitations": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine physische Taste, mittlere/zusätzliche Maustaste oder Mausradrichtung mit optionalen Modifikatoren erfassen. Caps Lock, reine Modifikatortasten, Fn und Gesten fehlen noch. Escape bricht die Erfassung ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a physical key, middle/extra mouse button or wheel direction with optional modifiers. Caps Lock, modifier-only keys, Fn and gestures are not supported. Escape cancels recording."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une touche, un bouton central/supplémentaire ou une direction de molette avec des modificateurs facultatifs. Verr. maj., modificateurs seuls, Fn et gestes ne sont pas pris en charge. Échap annule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите физическую клавишу, среднюю/дополнительную кнопку мыши или направление колеса с модификаторами. Caps Lock, отдельные модификаторы, Fn и жесты пока не поддерживаются. Escape отменяет запись."
          }
        }
      }
    },
