    "mouseActionFailed" : {
      "comment" : "Mouse output action/category or execution contract; not a physical trigger.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mausklick konnte nicht vorbereitet werden. Lassen Sie die Ausgabetaste der Maus los und versuchen Sie es erneut. Die ursprüngliche Eingabe wurde nicht wiederholt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not prepare the mouse click. Make sure the output mouse button is released and try again. The original input was not replayed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de préparer le clic de souris. Relâchez le bouton de sortie de la souris et réessayez. L’entrée d’origine n’a pas été répétée."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подготовить клик мыши. Отпустите выходную кнопку мыши и попробуйте снова. Исходный ввод не повторяется."
          }
        }
      }
    },
    "mouseActionHint" : {
      "comment" : "Mouse output action/category or execution contract; not a physical trigger.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klickt an der aktuellen Zeigerposition ohne Tastaturmodifikatoren. Ein Doppelklick sendet zwei Linksklicks. Ist die Ausgabetaste bereits gedrückt, wird ein Fehler gemeldet, statt sie loszulassen. Ziehen und das Halten einer Ausgabetaste werden nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicks at the current pointer position without keyboard modifiers. Double click sends two left clicks. If the output button is already held, the action reports an error instead of releasing it. Dragging and held-button output are not supported."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique à la position actuelle du pointeur sans modificateur clavier. Le double clic envoie deux clics gauches. Si le bouton de sortie est déjà maintenu, une erreur est signalée pour éviter de le relâcher. Le glisser-déposer et le maintien d’un bouton de sortie ne sont pas pris en charge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клик в текущей позиции указателя без модификаторов клавиатуры. Двойной клик отправляет два левых клика. Если выходная кнопка уже удерживается, действие сообщает об ошибке, чтобы не отпустить её. Перетаскивание и удержание выходной кнопки не поддерживаются."
          }
        }
      }
    },
    "mouseActions" : {
      "comment" : "Mouse output action/category or execution contract; not a physical trigger.",
      "extractionState" : "manual",
      "localizations" : {
