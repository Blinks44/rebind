          }
        }
      }
    },
    "diagnosticsHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Maustasten und Mausrad; Tastaturereignisse, Text und Zeigerkoordinaten sind ausgeschlossen. Quartz-Tastencodes beginnen bei 0. Regeln bleiben aktiv. „In Warteschlange“ bestätigt die Übergabe an die Engine, nicht die Zustellung an eine andere App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse buttons and wheel only; keyboard events, text and pointer coordinates are excluded. Quartz button codes start at 0. Rules remain active. “Queued” confirms handoff to the engine, not delivery to another app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boutons de souris et molette uniquement ; événements clavier, texte et coordonnées du pointeur exclus. Les codes Quartz commencent à 0. Les règles restent actives. « En attente » confirme le transfert au moteur, pas la réception par une autre app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только кнопки мыши и колесо: события клавиатуры, текст и координаты указателя исключены. Коды кнопок Quartz начинаются с 0. Правила продолжают действовать. «В очереди» означает передачу движку, а не доставку в другое приложение."
          }
        }
      }
    },
    "diagnosticsInput": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrée"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод"
          }
        }
      }
    },
    "diagnosticsLimits": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 128 Einträge, 20 pro Sekundenfenster, 60 Sekunden pro Sitzung. Nur im Speicher; Schließen, Ruhezustand, sichere Eingabe oder Zugriffsverlust stoppen die Erfassung und löschen die Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 128 entries, 20 per one-second window, 60 seconds per session. Memory only; closing, sleep, Secure Input or loss of access stops collection and clears the data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 128 entrées, 20 par fenêtre d’une seconde, 60 secondes par session. En mémoire uniquement ; fermeture, veille, saisie sécurisée ou perte d’accès arrêtent la collecte et effacent les données."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 128 записей, 20 за секундное окно, 60 секунд на сеанс. Только в памяти; закрытие, сон, защищённый ввод или потеря доступа останавливают сбор и очищают данные."
          }
        }
      }
    },
    "diagnosticsModifiers": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifikatoren"
          }
        },
