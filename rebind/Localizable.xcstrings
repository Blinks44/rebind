    "inputMonitoringNotRequiredHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die aktuelle Tastatur- und Mausbelegung ist keine separate Eingabeüberwachung nötig: Bedienungshilfen erlauben bereits das Empfangen von Ereignissen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate Input Monitoring grant is not needed for the current keyboard and mouse remapping engine: Accessibility already allows listening to events."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur actuel de remappage du clavier et de la souris ne nécessite pas d’autorisation distincte Surveillance de l’entrée : Accessibilité permet déjà de recevoir les événements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для текущего переназначения клавиатуры и мыши отдельный «Мониторинг ввода» не нужен: «Универсальный доступ» уже разрешает получение событий."
          }
        }
      }
    },
