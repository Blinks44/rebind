    "phaseOneHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Implemented, hardware verification pending. One output shortcut per press; held output and repeats are not supported."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реализовано, требуется аппаратная проверка. Одно выходное сочетание на нажатие; удержание и повторы пока не поддерживаются."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Implementiert, Hardwareprüfung ausstehend. Eine Ausgabekombination pro Druck; gehaltene Ausgabe und Wiederholung fehlen noch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Implémenté, vérification matérielle requise. Un raccourci par pression ; maintien et répétition non pris en charge."
          }
        }
      }
    },
    "emergencyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency pause: ⌃⌥⇧⌘ Escape. You can also pause from the menu bar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аварийная пауза: ⌃⌥⇧⌘ Escape. Также можно приостановить правила через строку меню."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notfallpause: ⌃⌥⇧⌘ Escape. Auch über die Menüleiste pausierbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause d’urgence : ⌃⌥⇧⌘ Échap. Également disponible dans la barre des menus."
          }
        }
      }
    },
    "deviceScopeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category-wide rules only. Mouse Button 4 means Quartz index 3. Per-device rules and gestures await verification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила для всей категории устройств. Кнопка мыши 4 — индекс Quartz 3. Привязка к отдельным устройствам и жесты ожидают проверки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegungen gelten für die gesamte Kategorie. Maustaste 4 entspricht Quartz-Index 3. Gerätezuordnung und Gesten erfordern weitere Prüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles par catégorie uniquement. Bouton 4 correspond à l’indice Quartz 3. Règles par appareil et gestes en attente de vérification."
          }
        }
      }
    },
