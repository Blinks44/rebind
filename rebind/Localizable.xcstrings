    "mediaActionFailed" : {
      "comment" : "Media playback action or dispatch error.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Medientaste konnte nicht gesendet werden. Prüfe den Bedienungshilfenzugriff und versuche es erneut. Die ursprüngliche Eingabe wurde nicht erneut gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The media key could not be sent. Check Accessibility access and try again. The original input was not replayed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’envoyer la touche multimédia. Vérifiez l’accès Accessibilité et réessayez. L’entrée d’origine n’a pas été renvoyée."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось отправить медиаклавишу. Проверьте «Универсальный доступ» и повторите попытку. Исходный ввод не воспроизведён."
          }
        }
      }
    },
    "mediaActionHint" : {
      "comment" : "Native system media-key output; recipient selected by macOS.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet eine System-Medientaste ohne Modifikatortasten. macOS wählt den Player und dessen Reaktion. Ein geeigneter Player und ein unterstützter Befehl sind erforderlich; Rebind kann die Wiedergabeänderung nicht bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends a system media key without modifiers. macOS selects the player and its response. A supported command and an eligible player are required; playback cannot be confirmed by Rebind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie une touche multimédia système sans modificateurs. macOS choisit le lecteur et sa réponse. Un lecteur disponible et une commande prise en charge sont nécessaires ; Rebind ne peut pas confirmer le changement de lecture."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет системную медиаклавишу без модификаторов. Проигрыватель и реакцию выбирает macOS. Нужны доступный проигрыватель и поддерживаемая команда; Rebind не может подтвердить изменение воспроизведения."
          }
        }
      }
    },
