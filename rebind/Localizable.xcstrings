    "advancedDiagnosticsBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is unavailable while the input engine is stopped, access is missing or Secure Input is active."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись недоступна, если механизм ввода остановлен, нет разрешений или включён безопасный ввод."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzeichnung nicht verfügbar, wenn die Eingabe-Engine angehalten ist, Zugriff fehlt oder sichere Eingabe aktiv ist."
          }
        },
