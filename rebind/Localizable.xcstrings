    "audioActionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls the current default audio output in steps of 6.25%. Volume changes leave mute unchanged. Some outputs have no writable main volume or mute control."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляет текущим аудиовыходом с шагом 6,25%. Изменение громкости не включает звук, если он отключён. Некоторые выходы не поддерживают общую громкость или отключение звука."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert die aktuelle Standard-Audioausgabe in Schritten von 6,25 %. Lautstärkeänderungen ändern die Stummschaltung nicht. Manche Ausgaben unterstützen keine regelbare Gesamtlautstärke oder Stummschaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle la sortie audio par défaut par pas de 6,25 %. Modifier le volume ne change pas la sourdine. Certaines sorties ne permettent pas de régler le volume général ou la sourdine."
          }
        }
      }
    },
