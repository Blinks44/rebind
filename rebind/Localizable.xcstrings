    "openSystemSettingsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the macOS System Settings app. No settings are changed. The app may reopen its last viewed pane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает приложение «Системные настройки» macOS. Настройки не изменяются. Приложение может открыть последний просмотренный раздел."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die macOS-Systemeinstellungen. Einstellungen werden nicht geändert. Die App kann den zuletzt geöffneten Bereich anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’app Réglages Système de macOS. Aucun réglage n’est modifié. L’app peut rouvrir le dernier volet consulté."
          }
        }
      }
    },
    "openTargetHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the selected application, or the address/file in its default app. Moved files and applications must be selected again. The mapped input is consumed even if opening fails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает выбранное приложение либо адрес или файл в приложении по умолчанию. Перемещённые файлы и приложения нужно выбрать заново. Назначенный ввод поглощается и при ошибке открытия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das ausgewählte Programm oder die Adresse/Datei im Standardprogramm. Verschobene Dateien und Programme erneut auswählen. Die zugewiesene Eingabe wird auch bei einem Fehler unterdrückt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’application choisie, ou l’adresse/le fichier dans l’application par défaut. Sélectionnez à nouveau les fichiers et applications déplacés. L’entrée associée est interceptée même si l’ouverture échoue."
          }
        }
      }
    },
