          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить правило"
          }
        }
      }
    },
    "doublePressActivation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltes Drücken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double press"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double pression"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойное нажатие"
          }
        }
      }
    },
    "doublePressHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loslassen und innerhalb des macOS-Doppelklickintervalls erneut drücken. Beide Betätigungen werden abgefangen; eine einzelne löst nichts aus. Andere Betätigungen, Modifikatorwechsel, Wiederholungen und Ziehen brechen die Folge ab. Ein Auslösungsmodus pro Kombination."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release and press again within the macOS double-click interval. Both presses are consumed; a single press does nothing. Other presses, modifier changes, repeats and dragging cancel the sequence. Only one activation mode per source combination."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâchez puis appuyez à nouveau dans le délai de double-clic de macOS. Les deux pressions sont interceptées ; une seule ne fait rien. Une autre pression, un changement de modificateurs, la répétition ou un glissement annule la séquence. Un mode par combinaison."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпустите и нажмите снова в пределах интервала двойного щелчка macOS. Оба нажатия поглощаются; одиночное ничего не делает. Другие нажатия, смена модификаторов, повторы и перетаскивание отменяют последовательность. Для сочетания доступен один режим срабатывания."
          }
        }
      }
    },
    "editBinding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegung bearbeiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Binding"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier la règle"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить правило"
          }
        }
      }
    },
    "emergencyHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notfallpause: ⌃⌥⇧⌘ Escape. Auch über die Menüleiste pausierbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency pause: ⌃⌥⇧⌘ Escape. You can also pause from the menu bar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause d’urgence : ⌃⌥⇧⌘ Échap. Également disponible dans la barre des menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аварийная пауза: ⌃⌥⇧⌘ Escape. Также можно приостановить правила через строку меню."
          }
        }
      }
    },
