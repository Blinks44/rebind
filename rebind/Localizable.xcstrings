            "value": "Двойной тап четырьмя пальцами"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen mit vier Fingern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double toucher à quatre doigts"
          }
