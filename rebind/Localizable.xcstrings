    "trackpadSecondaryClickHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This rule replaces the trackpad’s secondary click. It works while Secondary click is set to Click with Two Fingers in System Settings → Trackpad → Point & Click."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это правило заменяет имитацию правой кнопки на трекпаде. Оно работает, когда в Системных настройках → Трекпад → Выбор и нажатие для имитации правой кнопки выбрано нажатие двумя пальцами."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Regel ersetzt den Sekundärklick des Trackpads. Sie funktioniert, wenn unter Systemeinstellungen → Trackpad → Zeigen & Klicken für den Sekundärklick „Mit zwei Fingern klicken“ gewählt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette règle remplace le clic secondaire du trackpad. Elle fonctionne lorsque le clic secondaire est réglé sur « Cliquer avec deux doigts » dans Réglages Système → Trackpad → Pointer et cliquer."
          }
        }
      }
    },
    "trackpadMultiFingerClickHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This rule replaces the ordinary click made with this many fingers. Clicking while other fingers rest on the trackpad can also run it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это правило заменяет обычное нажатие, сделанное таким числом пальцев. Оно может сработать и при нажатии, когда другие пальцы просто лежат на трекпаде."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Regel ersetzt den normalen Klick mit so vielen Fingern. Sie kann auch auslösen, wenn beim Klicken weitere Finger auf dem Trackpad ruhen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette règle remplace le clic ordinaire effectué avec ce nombre de doigts. Elle peut aussi se déclencher si d’autres doigts reposent sur le trackpad pendant le clic."
          }
        }
      }
    },
