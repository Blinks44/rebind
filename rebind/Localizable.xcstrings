          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind работает и с закрытым окном. Приостановить правила можно в любой момент через панель меню."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind arbeitet auch bei geschlossenem Fenster. Über die Menüleiste kannst du Belegungen jederzeit pausieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
