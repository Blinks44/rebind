    "dockActionHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimentell. Rebind spricht macOS direkt an, statt ein Tastenkürzel zu senden; nach einem Systemupdate funktioniert das möglicherweise nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental. Rebind asks macOS directly instead of sending a keyboard shortcut, so this may stop working after a system update."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expérimental. Rebind s’adresse directement à macOS au lieu d’envoyer un raccourci clavier ; cela peut cesser de fonctionner après une mise à jour du système."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспериментальное действие. Rebind обращается к macOS напрямую, без сочетания клавиш, поэтому после обновления системы оно может перестать работать."
          }
        }
      }
    },
