        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Rebind dans Confidentialité et sécurité → Accessibilité. Revenez ici pour vérifier l’accès."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В разделе «Конфиденциальность и безопасность» → «Универсальный доступ» включите Rebind. Вернитесь сюда, чтобы проверить доступ."
          }
        }
      }
    },
