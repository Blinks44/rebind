        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить команды. Откройте приложение «Команды», проверьте доступ и обновите список."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle konnten nicht geladen werden. Öffnen Sie die App „Kurzbefehle“, prüfen Sie den Zugriff und aktualisieren Sie die Liste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les raccourcis. Ouvrez l’application Raccourcis, vérifiez l’accès et actualisez la liste."
          }
        }
      }
