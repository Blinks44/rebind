    "audioActionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not change the audio output. Check the selected sound output; the consumed input is not replayed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить звук. Проверь выбранный аудиовыход; перехваченный ввод не повторяется."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audioausgabe konnte nicht geändert werden. Prüfe die ausgewählte Tonausgabe; die abgefangene Eingabe wird nicht wiederholt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier le son. Vérifiez la sortie audio sélectionnée ; l’entrée interceptée n’est pas rejouée."
          }
        }
      }
    },
    "audioActionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls the current default audio output in steps of 6.25%. Volume changes leave mute unchanged. Some outputs have no writable main volume or mute control."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляет текущим аудиовыходом с шагом 6,25%. Изменение громкости не включает звук, если он отключён. Некоторые выходы не поддерживают общую громкость или отключение звука."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert die aktuelle Standard-Audioausgabe in Schritten von 6,25 %. Lautstärkeänderungen ändern die Stummschaltung nicht. Manche Ausgaben unterstützen keine regelbare Gesamtlautstärke oder Stummschaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle la sortie audio par défaut par pas de 6,25 %. Modifier le volume ne change pas la sourdine. Certaines sorties ne permettent pas de régler le volume général ou la sourdine."
          }
        }
      }
    },
    "audioActionUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable for the current audio output. This rule passes input through."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступно для текущего аудиовыхода. Правило пропускает ввод."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die aktuelle Audioausgabe nicht verfügbar. Diese Regel lässt Eingaben durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible pour la sortie audio actuelle. Cette règle laisse passer les entrées."
          }
        }
      }
    },
