    "appleShortcutFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kurzbefehl ist fehlgeschlagen oder hat 60 Sekunden überschritten. Prüfen Sie ihn und seine Berechtigungen in der App „Kurzbefehle“. Die Eingabe wurde nicht wiederholt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shortcut failed or exceeded 60 seconds. Check it in the Shortcuts app and its permissions. No input was replayed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci a échoué ou dépassé 60 secondes. Vérifiez-le et ses autorisations dans Raccourcis. L’entrée initiale n’a pas été rejouée."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда завершилась с ошибкой или превысила 60 секунд. Проверьте её в приложении «Команды» и необходимые разрешения. Исходный ввод не повторяется."
          }
        }
      }
    },
    "appleShortcutHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt den gewählten Kurzbefehl anhand seiner ID aus, ohne Text, Dateien oder Zwischenablage zu übergeben. Limit: 60 Sekunden; andere Aktionen warten. Pause und Profilwechsel beenden das Warten, machen ausgeführte Schritte aber nicht rückgängig. Berechtigungen werden von Kurzbefehle angefordert. Zugeordnete Eingaben werden auch bei Fehlern unterdrückt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs your selected shortcut by its identifier, without passing text, files or clipboard input. The limit is 60 seconds; other actions wait while it runs. Pause/profile changes stop waiting, but cannot undo steps already performed. Shortcuts manages its own permission prompts. Assigned input is consumed even if execution fails."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute le raccourci choisi par son identifiant, sans transmettre de texte, de fichiers ni le presse-papiers. Limite : 60 secondes ; les autres actions attendent. La pause et le changement de profil interrompent l’attente sans annuler les étapes déjà effectuées. Raccourcis gère ses autorisations. L’entrée affectée est bloquée même en cas d’échec."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает выбранную команду по её ID без передачи текста, файлов или буфера обмена. Лимит — 60 секунд; остальные действия ждут завершения. Пауза и смена профиля останавливают ожидание, но не отменяют уже выполненные шаги. Разрешения запрашивает приложение «Команды». Назначенный ввод поглощается и при ошибке запуска."
          }
        }
      }
    },
    "appleShortcutMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
