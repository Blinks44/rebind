    "postingPermissionHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen sind aktiviert, aber die Prüfung für das Senden von Ereignissen bestätigt noch keinen Zugriff. Klicken Sie auf „Senden von Ereignissen erlauben“, aktualisieren Sie den Status oder starten Sie Rebind bei Aufforderung neu. Die Eingabebelegung bleibt bis zur Bestätigung pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is enabled, but the event-sending check still reports no access. Click Allow Event Sending to request that capability, then refresh or relaunch if macOS asks. Rebind keeps remapping paused until access is confirmed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité est activée, mais la vérification de l’envoi d’événements ne confirme pas encore l’accès. Cliquez sur « Autoriser l’envoi d’événements », actualisez les autorisations ou relancez Rebind si macOS le demande. Le remappage reste en pause jusqu’à confirmation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Универсальный доступ» включён, но проверка отправки событий пока не подтверждает доступ. Нажмите «Разрешить отправку событий», затем проверьте разрешения или перезапустите Rebind, если macOS попросит. До подтверждения переназначение остаётся на паузе."
          }
        }
      }
    },
    "pressActivation": {
      "extractionState": "manual",
      "localizations": {
