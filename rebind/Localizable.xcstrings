      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltes Drücken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double press"
          }
        },
        "fr": {
          "stringUnit": {
