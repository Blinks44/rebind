    "backgroundDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Schließen dieses Fensters bleibt Rebind in der Menüleiste. Öffne es dort, um Regeln zu verwalten oder Belegungen zu pausieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this window keeps Rebind in the menu bar. Open it there to manage rules or pause remapping."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la fermeture de cette fenêtre, Rebind reste dans la barre des menus. Ouvrez-le depuis cette barre pour gérer les règles ou mettre les remappages en pause."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После закрытия окна Rebind остаётся в строке меню. Откройте его там, чтобы управлять правилами или приостановить переназначения."
          }
        }
      }
    },
    "backgroundHint": {
      "extractionState": "manual",
      "localizations": {
