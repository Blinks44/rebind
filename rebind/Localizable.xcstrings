            "value": "Веб-адрес"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Webadresse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse web"
          }
        }
      }
    },
    "targetNotSelected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No target selected"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель не выбрана"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ziel ausgewählt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune cible sélectionnée"
          }
        }
      }
    },
    "webAddressInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete HTTP or HTTPS address without a username or password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите полный адрес HTTP или HTTPS без имени пользователя и пароля."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine vollständige HTTP- oder HTTPS-Adresse ohne Benutzernamen oder Passwort ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse HTTP ou HTTPS complète, sans nom d’utilisateur ni mot de passe."
          }
        }
      }
    },
    "targetSelectionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not use this selection. Choose an application other than Rebind, or a local file or folder for the selected action."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось использовать выбранную цель. Выберите приложение кроме Rebind либо локальный файл или папку для выбранного действия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl konnte nicht verwendet werden. Wählen Sie ein anderes Programm als Rebind oder eine lokale Datei bzw. einen Ordner für diese Aktion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sélection ne peut pas être utilisée. Choisissez une application autre que Rebind, ou un fichier ou dossier local pour cette action."
          }
        }
      }
    },
    "activateApplicationHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activates the selected copy only if it is already running. Does not launch it. If the app moves, select it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключает на выбранную копию, только если она уже запущена. Не запускает её. После перемещения приложения выберите его заново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert die ausgewählte Kopie nur, wenn sie bereits läuft. Startet sie nicht. Nach dem Verschieben erneut auswählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la copie choisie uniquement si elle est déjà ouverte, sans la lancer. Sélectionnez-la à nouveau si elle est déplacée."
          }
        }
      }
    },
    "openTargetHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the selected application, or the address/file in its default app. Moved files and applications must be selected again. The mapped input is consumed even if opening fails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает выбранное приложение либо адрес или файл в приложении по умолчанию. Перемещённые файлы и приложения нужно выбрать заново. Назначенный ввод поглощается и при ошибке открытия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das ausgewählte Programm oder die Adresse/Datei im Standardprogramm. Verschobene Dateien und Programme erneut auswählen. Die zugewiesene Eingabe wird auch bei einem Fehler unterdrückt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’application choisie, ou l’adresse/le fichier dans l’application par défaut. Sélectionnez à nouveau les fichiers et applications déplacés. L’entrée associée est interceptée même si l’ouverture échoue."
          }
        }
      }
    },
    "workspaceActionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open or activate the target. Check that the selected app or file still exists, that the app is running for activation, and that a default app can open the address or file."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть или активировать цель. Проверьте, что выбранное приложение или файл существует, приложение запущено для активации, а адрес или файл можно открыть в приложении по умолчанию."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel konnte nicht geöffnet oder aktiviert werden. Prüfen Sie, ob das Programm oder die Datei noch vorhanden ist, ob das zu aktivierende Programm läuft und ob ein Standardprogramm die Adresse oder Datei öffnen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir ou d’activer la cible. Vérifiez que l’application ou le fichier existe, que l’application à activer est ouverte et qu’une application par défaut peut ouvrir l’adresse ou le fichier."
          }
        }
      }
    },
    "openingTargetStatus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the application or file to open…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается открытие приложения или файла…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf das Öffnen des Programms oder der Datei…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de l’ouverture de l’application ou du fichier…"
          }
        }
      }
    }
  },
  "version": "1.1"
}
