        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните копию профилей и привязок. При импорте подтвердите замену текущих данных."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile und Belegungen sichern. Beim Import werden die aktuellen Daten nach Bestätigung ersetzt."
