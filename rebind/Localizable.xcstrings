    "wheelMappingHint": {
      "comment": "Limits apply to discrete line-based scroll events, globally across wheel rules. No physical device attribution is claimed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diskrete Mausradereignisse; insgesamt bis zu 10 Tastenkombinationen pro Sekunde für Mausradbelegungen. Sanftes, träges und diagonales Scrollen bleibt erhalten. Richtungen folgen macOS-Einstellungen; umgewandelte Ereignisse können ebenfalls passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discrete wheel events only; up to 10 shortcuts per second across wheel rules. Smooth, momentum and diagonal scrolling pass through. Directions follow macOS settings; converted events can also match."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Événements discrets de molette uniquement ; jusqu’à 10 raccourcis par seconde pour l’ensemble des règles de molette. Le défilement fluide, inertiel et diagonal est conservé. Les directions suivent les réglages macOS ; les événements convertis peuvent aussi correspondre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только дискретная прокрутка: до 10 сочетаний в секунду суммарно для правил колеса. Плавная, инерционная и диагональная прокрутка сохраняются. Направления зависят от настроек macOS; преобразованные события тоже могут совпадать."
          }
        }
      }
    },
    "windowActionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window action could not be completed. Check Accessibility and whether the active app supports this operation. Focus changes, dialogs and an unresponsive app can prevent it. The original input was not replayed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить действие с окном. Проверьте «Универсальный доступ» и поддержку операции активным приложением. Смена фокуса, диалог или зависшее приложение могут помешать. Исходный ввод не повторялся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fensteraktion konnte nicht ausgeführt werden. Prüfen Sie die Bedienungshilfen und die Unterstützung durch das aktive Programm. Fokuswechsel, Dialoge oder ein nicht reagierendes Programm können sie verhindern. Die ursprüngliche Eingabe wurde nicht wiederholt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action de fenêtre n’a pas pu être exécutée. Vérifiez l’accès Accessibilité et la prise en charge par l’application active. Un changement de focus, une boîte de dialogue ou une application bloquée peuvent l’empêcher. L’entrée d’origine n’a pas été répétée."
          }
        }
      },
      "comment": "Active target is resolved when dispatch begins. AX acceptance does not confirm that a window closed or an animation finished."
    },
    "windowActionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the active app or window when the action begins. Requires Accessibility and support from the target app. Rebind itself is excluded. Unsupported targets report an error; the mapped input is consumed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует активное приложение или окно в момент начала действия. Нужны «Универсальный доступ» и поддержка со стороны приложения. На сам Rebind не действует. При неподдерживаемой цели появится ошибка; назначенный ввод поглощается."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das aktive Programm oder Fenster beim Start der Aktion. Erfordert Bedienungshilfen und Unterstützung durch das Zielprogramm. Rebind selbst ist ausgeschlossen. Nicht unterstützte Ziele melden einen Fehler; die zugewiesene Eingabe wird unterdrückt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l’application ou la fenêtre active au début de l’action. Nécessite l’accès Accessibilité et la prise en charge par l’application cible. Rebind est exclu. Une cible non prise en charge affiche une erreur ; l’entrée associée est interceptée."
          }
        }
      },
      "comment": "Active target is resolved when dispatch begins. AX acceptance does not confirm that a window closed or an animation finished."
    },
