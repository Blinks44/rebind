    "activateApplicationAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate Running Application"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активировать запущенное приложение"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufendes Programm aktivieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer une application ouverte"
          }
        }
      }
    },
    "activateApplicationHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activates the selected copy only if it is already running. Does not launch it. If the app moves, select it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключает на выбранную копию, только если она уже запущена. Не запускает её. После перемещения приложения выберите его заново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert die ausgewählte Kopie nur, wenn sie bereits läuft. Startet sie nicht. Nach dem Verschieben erneut auswählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la copie choisie uniquement si elle est déjà ouverte, sans la lancer. Sélectionnez-la à nouveau si elle est déplacée."
          }
        }
      }
    },
    "activationTitle": {
