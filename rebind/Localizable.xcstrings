    },
    "Rebind": {},
    "accessLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access lost"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ потерян"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff verloren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès perdu"
          }
        }
      }
    },
    "accessLostPurpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bindings are stopped. Your rules are still saved. Normal keyboard and mouse input remains available."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила остановлены, но сохранены. Клавиатура и мышь продолжают работать как обычно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegungen sind gestoppt. Deine Regeln bleiben gespeichert. Tastatur und Maus funktionieren weiterhin normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles sont arrêtées, mais restent enregistrées. Le clavier et la souris continuent de fonctionner normalement."
          }
        }
      }
    },
    "accessibilityPermission": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ"
          }
        }
      }
    },
    "accessibilityPurpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Rebind to recognize your triggers and perform the actions you choose in other apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Rebind распознавать ваши триггеры и выполнять выбранные действия в других приложениях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Rebind, deine Auslöser zu erkennen und die gewählten Aktionen in anderen Apps auszuführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Rebind à reconnaître vos déclencheurs et à exécuter les actions choisies dans les autres apps."
          }
        }
      }
    },
    "accessibilitySteps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Privacy & Security → Accessibility, turn on Rebind. Return here to check access."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Конфиденциальность и безопасность» → «Универсальный доступ» включите Rebind. Вернитесь сюда, чтобы проверить доступ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Rebind unter Datenschutz & Sicherheit → Bedienungshilfen. Kehre zurück, um den Zugriff zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Rebind dans Confidentialité et sécurité → Accessibilité. Revenez ici pour vérifier l’accès."
          }
        }
      }
    },
