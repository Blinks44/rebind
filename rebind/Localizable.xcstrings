    "tapCreationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to create event tap. Pause, check permissions, then enable again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать перехватчик. Приостановите правила, проверьте разрешения и включите их снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Event-Tap konnte nicht erstellt werden. Pausieren, Berechtigungen prüfen und erneut aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer le filtre. Suspendez, vérifiez les autorisations, puis réactivez."
          }
        }
      }
    },
    "engineInterrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS disabled capture. Check permissions and enable again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS отключила перехват. Проверьте разрешения и включите правила снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Erfassung deaktiviert. Berechtigungen prüfen und erneut aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a désactivé la capture. Vérifiez les autorisations, puis réactivez."
          }
        }
      }
    },
    "outputFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut output failed. Remapping has been paused."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить сочетание. Переназначения приостановлены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkombination konnte nicht gesendet werden. Belegungen pausiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’envoi du raccourci. Remappage suspendu."
          }
        }
      }
    },
    "storageUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration could not be read. Editing is locked to preserve the file. Check ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать настройки. Изменения заблокированы для сохранности файла. Проверьте ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguration nicht lesbar. Bearbeitung zum Schutz der Datei gesperrt. Prüfen Sie ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration illisible. Modification bloquée pour préserver le fichier. Vérifiez ~/Library/Application Support/Rebind/configuration.json."
          }
        }
      }
    },
    "storageWriteFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save settings. Check available disk space and file permissions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить настройки. Проверьте свободное место и права доступа к файлу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen konnten nicht gespeichert werden. Speicherplatz und Dateirechte prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les réglages. Vérifiez l’espace disque et les permissions du fichier."
          }
        }
      }
    },
    "bindingConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An enabled binding already uses this exact trigger and modifiers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активное правило уже использует этот триггер и набор модификаторов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine aktive Belegung verwendet bereits diese Eingabe und Modifikatoren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle active utilise déjà cette entrée et ces modificateurs."
          }
        }
      }
    },
    "bindingInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported binding. The emergency shortcut is reserved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподдерживаемое правило. Аварийное сочетание зарезервировано."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstützte Belegung. Die Notfallkombination ist reserviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle non prise en charge. Le raccourci d’urgence est réservé."
          }
        }
      }
    },
    "permissionsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow input remapping"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите переназначение ввода"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabebelegung erlauben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le remappage"
          }
        }
      }
    },
    "permissionsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind uses Accessibility to filter and send events, and Input Monitoring to receive physical key and mouse events. Typed text is never stored or logged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind использует «Универсальный доступ» для фильтрации и отправки событий, а «Мониторинг ввода» — для получения событий клавиш и мыши. Вводимый текст не сохраняется и не записывается в журнал."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind benötigt Bedienungshilfen zum Filtern und Senden sowie Eingabeüberwachung zum Empfangen von Tasten- und Mausereignissen. Eingegebener Text wird weder gespeichert noch protokolliert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind utilise Accessibilité pour filtrer et envoyer les événements, et Surveillance de l’entrée pour recevoir les événements du clavier et de la souris. Aucun texte saisi n’est enregistré ni journalisé."
          }
        }
      }
    },
