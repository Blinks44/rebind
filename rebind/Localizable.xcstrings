    "accessibilityPurpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Rebind, Ihre Auslöser zu erkennen und die gewählten Aktionen in anderen Apps auszuführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Rebind to recognize your triggers and perform the actions you choose in other apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Rebind à reconnaître vos déclencheurs et à exécuter les actions choisies dans les autres apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Rebind распознавать ваши триггеры и выполнять выбранные действия в других приложениях."
          }
        }
      }
    },
    "accessibilitySteps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie Rebind unter Datenschutz & Sicherheit → Bedienungshilfen. Kehren Sie dann hierher zurück, um den Zugriff zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Privacy & Security → Accessibility, turn on Rebind. Return here to check access."
