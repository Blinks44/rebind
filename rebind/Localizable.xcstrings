        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет команд. Создайте команду в приложении «Команды» и обновите список."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kurzbefehle. Erstellen Sie einen in der App „Kurzbefehle“ und aktualisieren Sie die Liste."
          }
