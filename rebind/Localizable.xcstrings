    },
    "lockScreenHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental: requests the native Lock Screen through an undocumented macOS 26/27 API. It may stop working after a system update. No keyboard shortcut is sent; verify that the screen actually locks. Unlock through macOS as usual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспериментально: запрашивает системную блокировку экрана через недокументированный API macOS 26/27. После обновления системы действие может перестать работать. Сочетание клавиш не отправляется; проверьте, что экран действительно заблокирован. Разблокируйте Mac обычным способом."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell: fordert die native Bildschirmsperre über eine undokumentierte API von macOS 26/27 an. Nach einem Systemupdate kann die Funktion ausfallen. Es wird kein Tastaturkurzbefehl gesendet; prüfen Sie die tatsächliche Sperre. Entsperren Sie den Mac wie gewohnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expérimental : demande le verrouillage natif via une API non documentée de macOS 26/27. Une mise à jour du système peut empêcher son fonctionnement. Aucun raccourci clavier n’est envoyé ; vérifiez que l’écran est verrouillé. Déverrouillez le Mac comme d’habitude."
          }
        }
      }
    },
