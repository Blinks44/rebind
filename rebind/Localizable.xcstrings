          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement est indisponible si le moteur d’entrée est arrêté, si l’accès manque ou si la saisie sécurisée est active."
          }
        },
        "ru" : {
          "stringUnit" : {
