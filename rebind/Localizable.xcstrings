    "permissionsEnableAccessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Accessibility to use your bindings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите универсальный доступ для работы правил."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Bedienungshilfen, um deine Belegungen zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accessibilité pour utiliser vos règles."
          }
        }
      }
    },
    "permissionsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind nutzt Bedienungshilfen zum Empfangen, Filtern und Senden von Tastatur- und Mausereignissen. Eingegebener Text wird weder gespeichert noch protokolliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind uses Accessibility to receive, filter and send keyboard and mouse events. Typed text is never stored or logged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind utilise Accessibilité pour recevoir, filtrer et envoyer les événements du clavier et de la souris. Aucun texte saisi n’est enregistré ni journalisé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind использует «Универсальный доступ» для получения, фильтрации и отправки событий клавиатуры и мыши. Вводимый текст не сохраняется и не записывается в журнал."
          }
        }
      }
    },
    "permissionsOtherPurpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current bindings do not need separate Input Monitoring access. Automation is requested only when an action needs it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для текущих правил отдельный доступ к мониторингу ввода не нужен. Автоматизация запрашивается только для действий, которым она требуется."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Belegungen benötigen keinen separaten Zugriff auf die Eingabeüberwachung. Automation wird nur angefragt, wenn eine Aktion sie braucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles actuelles ne nécessitent aucun accès séparé à la surveillance de l’entrée. L’automatisation est demandée uniquement si une action en a besoin."
          }
        }
      }
    },
    "permissionsRequired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Eingabebelegung ist der Zugriff auf Bedienungshilfen erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required for input remapping."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
