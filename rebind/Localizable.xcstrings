        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die aktuelle Audioausgabe nicht verfügbar. Diese Regel lässt Eingaben durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible pour la sortie audio actuelle. Cette règle laisse passer les entrées."
          }
        }
