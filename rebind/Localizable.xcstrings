          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время удержания клавиш и кнопок: 100–5 000 мс. Скорость двойного нажатия берётся из настроек двойного щелчка в macOS."
          }
        }
      }
    },
