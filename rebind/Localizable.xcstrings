    "mouseOutputListeningHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This records the output. It does not run the action. Escape cancels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывается выход. Действие не выполняется. Escape отменяет запись."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst nur die Ausgabe, ohne die Aktion auszuführen. Escape bricht ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre la sortie sans exécuter l’action. Échap annule."
          }
        }
