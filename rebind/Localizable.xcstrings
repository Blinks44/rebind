    "previousApplicationFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rückkehr zur vorherigen App ist fehlgeschlagen. Möglicherweise wurde sie beendet oder Sie haben seit dem Start von Rebind noch nicht zwischen zwei Apps gewechselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not return to the previous app. It may have quit, or you have not switched between two apps since Rebind started."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de revenir à l’app précédente. Elle a peut-être été fermée, ou vous n’avez pas encore basculé entre deux apps depuis l’ouverture de Rebind."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось вернуться в предыдущее приложение. Возможно, оно закрыто или после запуска Rebind вы ещё не переключались между двумя приложениями."
          }
        }
      }
    },
    "previousApplicationHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehrt zur App zurück, die Sie vor der aktuellen verwendet haben. Funktioniert, sobald Sie seit dem Start von Rebind zwischen zwei Apps gewechselt haben; beendete Apps werden nicht erneut geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns to the app you used before the current one. It works after you have switched between two apps since Rebind started; closed apps are not reopened."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revient à l’app que vous utilisiez avant l’app actuelle. Fonctionne dès que vous avez basculé entre deux apps depuis l’ouverture de Rebind ; les apps fermées ne sont pas rouvertes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает в приложение, с которым вы работали до текущего. Начинает работать после того, как вы хотя бы раз переключитесь между двумя приложениями; закрытые приложения заново не открываются."
          }
        }
      }
    },
