    "mouseWheelHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record one wheel step with any held modifiers. Smooth, momentum and diagonal scrolling keep their normal behavior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите один шаг колеса с нужными модификаторами. Плавная, инерционная и диагональная прокрутка работают как обычно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Mausradschritt mit den gewünschten Modifikatoren erfassen. Sanftes, träges und diagonales Scrollen verhält sich wie gewohnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un pas de molette avec les modificateurs souhaités. Le défilement fluide, inertiel et diagonal reste inchangé."
          }
        }
      }
