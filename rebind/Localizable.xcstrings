    "permissionSettingsHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie diese Kopie von Rebind unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen. Fehlt sie, fügen Sie sie mit + hinzu; „App im Finder zeigen“ zeigt die laufende Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable this copy of Rebind in System Settings → Privacy & Security → Accessibility. If it is missing, add it with the + button; Show App in Finder reveals the running copy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette copie de Rebind dans Réglages Système → Confidentialité et sécurité → Accessibilité. Si elle manque, ajoutez-la avec + ; « Afficher l’app dans le Finder » indique la copie en cours d’exécution."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите эту копию Rebind в «Системные настройки» → «Конфиденциальность и безопасность» → «Универсальный доступ». Если её нет в списке, добавьте кнопкой +; «Показать приложение в Finder» укажет запущенную копию."
          }
        }
      }
    },
    "permissionsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind nutzt Bedienungshilfen zum Empfangen, Filtern und Senden von Tastatur- und Mausereignissen. Eingegebener Text wird weder gespeichert noch protokolliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind uses Accessibility to receive, filter and send keyboard and mouse events. Typed text is never stored or logged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind utilise Accessibilité pour recevoir, filtrer et envoyer les événements du clavier et de la souris. Aucun texte saisi n’est enregistré ni journalisé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind использует «Универсальный доступ» для получения, фильтрации и отправки событий клавиатуры и мыши. Вводимый текст не сохраняется и не записывается в журнал."
          }
        }
      }
    },
    "permissionsRequired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Eingabebelegung ist der Zugriff auf Bedienungshilfen erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required for input remapping."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation Accessibilité est requise pour le remappage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для переназначения нужен «Универсальный доступ»."
          }
        }
      }
    },
    "permissionsTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabebelegung erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow input remapping"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le remappage"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите переназначение ввода"
          }
        }
      }
    },
    "phaseOneHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionen: Tastenkombinationen, Mausklicks, verfügbare Audio- und Wiedergabesteuerung, Fenster- und Programmaktionen, Öffnen von Programmen, Webadressen und Dateien sowie Apple-Kurzbefehle. Direkte Mission-Control-Aktionen sind experimentell; Space-Wechsel verwenden Standard-Systemkurzbefehle. Multitouch ist geplant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions: keyboard shortcuts, mouse clicks, available sound and playback controls, supported window/app operations, opening apps/web addresses/files, and Apple Shortcuts. Direct Mission Control actions are experimental; Space navigation uses standard system shortcuts. Multitouch is planned."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions : raccourcis clavier, clics de souris, commandes audio et de lecture disponibles, opérations sur les fenêtres et applications, ouverture d’applications, d’adresses web et de fichiers, et raccourcis Apple. Les actions directes de Mission Control sont expérimentales ; le changement de bureau utilise les raccourcis système standard. Le multitouch est prévu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия: сочетания клавиш, клики мыши, доступное управление звуком и воспроизведением, операции с окнами и приложениями, открытие приложений, веб-адресов и файлов, быстрые команды Apple. Прямые действия Mission Control экспериментальные; переходы между рабочими столами используют штатные сочетания системы. Мультитач появится позже."
          }
        }
      },
      "comment": "Currently implemented action categories."
    },
    "physicalKey": {
      "comment": "Fallback display name for an explicitly configured physical key code; argument is the numeric code.",
