      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a middle or extra button and move up, down, left or right. Movement thresholds are fixed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте среднюю или дополнительную кнопку и двигайте мышь вверх, вниз, влево или вправо. Пороги движения фиксированы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die mittlere oder eine Zusatztaste und bewege die Maus nach oben, unten, links oder rechts. Bewegungsschwellen sind fest."
          }
        },
        "fr": {
          "stringUnit": {
