    "dockActionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not accept the Dock action. No keyboard fallback was sent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не приняла действие Dock. Запасное сочетание клавиш не отправлялось."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Dock-Aktion nicht angenommen. Es wurde kein Ersatzkurzbefehl gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas accepté l’action Dock. Aucun raccourci de secours n’a été envoyé."
          }
        }
      }
    },
    "dockActionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental direct macOS action: no keyboard shortcut is sent. Uses an undocumented Dock interface that may change after a system update. Request acceptance does not confirm the visual result."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспериментальное прямое действие macOS: сочетание клавиш не отправляется. Используется недокументированный интерфейс Dock, который может измениться после обновления системы. Принятый запрос не подтверждает результат на экране."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentelle direkte macOS-Aktion: Es wird kein Tastaturkurzbefehl gesendet. Verwendet eine undokumentierte Dock-Schnittstelle, die sich nach Systemupdates ändern kann. Ein angenommener Aufruf bestätigt nicht das sichtbare Ergebnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Action macOS directe expérimentale : aucun raccourci clavier n’est envoyé. Utilise une interface Dock non documentée, susceptible de changer après une mise à jour. L’acceptation de la requête ne confirme pas le résultat visuel."
          }
        }
      }
