    "doublePressHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loslassen und innerhalb des macOS-Doppelklickintervalls erneut drücken. Beide Betätigungen werden abgefangen; eine einzelne löst nichts aus. Andere Betätigungen, Modifikatorwechsel, Wiederholungen und Ziehen brechen die Folge ab. Ein Auslösungsmodus pro Kombination."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Release and press again within the macOS double-click interval. Both presses are consumed; a single press does nothing. Other presses, modifier changes, repeats and dragging cancel the sequence. Only one activation mode per source combination."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relâchez puis appuyez à nouveau dans le délai de double-clic de macOS. Les deux pressions sont interceptées ; une seule ne fait rien. Une autre pression, un changement de modificateurs, la répétition ou un glissement annule la séquence. Un mode par combinaison."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отпустите и нажмите снова в пределах интервала двойного щелчка macOS. Оба нажатия поглощаются; одиночное ничего не делает. Другие нажатия, смена модификаторов, повторы и перетаскивание отменяют последовательность. Для сочетания доступен один режим срабатывания."
          }
        }
      }
    },
