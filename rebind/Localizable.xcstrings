    },
    "mousePointerHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record the button, then choose a direction. To use the rule, hold that button and move the pointer. It runs once per hold."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите кнопку и выберите направление. Удерживайте её и двигайте мышь: действие сработает один раз за удержание."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taste erfassen und Richtung wählen. Taste gedrückt halten und die Maus bewegen: Die Aktion wird einmal pro Halten ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le bouton, puis choisissez une direction. Maintenez-le et déplacez la souris : une action par maintien."
          }
        }
      }
    },
    "mouseRecordingUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the required access in Settings → Permissions, then return to record your trigger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите нужный доступ в Настройках → Разрешения, затем вернитесь для записи триггера."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlichen Zugriff unter Einstellungen → Berechtigungen aktivieren und zur Erfassung zurückkehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accès requis dans Réglages → Autorisations, puis revenez enregistrer le déclencheur."
          }
        }
      }
