    "permissionsEnableAccessibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie „Bedienungshilfen“, damit Ihre Belegungen funktionieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Accessibility to use your bindings."
          }
