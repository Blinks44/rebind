    "signingHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Entwicklungsbuilds können nach dem Neubau erneut Zugriff benötigen. Bei Aufforderung durch macOS neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local development builds may require granting access again after rebuilding. Relaunch if macOS requests it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après compilation locale, les autorisations peuvent devoir être accordées à nouveau. Relancez si macOS le demande."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После пересборки локальной версии может потребоваться повторное разрешение. Перезапустите приложение, если macOS попросит."
          }
        }
      }
    },
    "sleepSystemAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Mac to Sleep"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевести Mac в режим сна"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac in den Ruhezustand versetzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre le Mac en veille"
          }
        }
      }
    },
    "sleepSystemFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sleep request was not accepted. Full system sleep may be unavailable or macOS may have refused access. Rebind does not change power settings or request administrator privileges."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос режима сна не принят. Полный сон системы может быть недоступен или macOS отказала в доступе. Rebind не меняет настройки питания и не запрашивает права администратора."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ruhezustandsanfrage wurde nicht angenommen. Der vollständige Systemruhezustand ist möglicherweise nicht verfügbar oder macOS hat den Zugriff verweigert. Rebind ändert keine Energieeinstellungen und fordert keine Administratorrechte an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande de mise en veille n’a pas été acceptée. La veille complète peut être indisponible ou macOS peut avoir refusé l’accès. Rebind ne modifie pas les réglages d’énergie et ne demande pas de droits administrateur."
          }
        }
      }
    },
    "sleepSystemHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests system sleep through macOS. An accepted request clears queued actions; macOS controls the transition. New input may wake the Mac, including release of the trigger button. Password requirements follow your existing settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает режим сна через macOS. После принятия запроса очередь действий очищается; переходом управляет система. Новый ввод может разбудить Mac, в том числе отпускание кнопки триггера. Запрос пароля зависит от ваших настроек."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert den Systemruhezustand über macOS an. Nach Annahme werden wartende Aktionen verworfen; macOS steuert den Übergang. Neue Eingaben können den Mac wecken, auch das Loslassen der Auslösertaste. Die Passwortabfrage folgt Ihren bestehenden Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande la mise en veille via macOS. Après acceptation, les actions en attente sont supprimées ; macOS contrôle la transition. Une nouvelle entrée peut réveiller le Mac, y compris le relâchement du bouton déclencheur. Le mot de passe dépend de vos réglages actuels."
          }
        }
      }
    },
    "sleepSystemUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full system sleep is unavailable on this Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный режим сна недоступен на этом Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vollständige Systemruhezustand ist auf diesem Mac nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille complète du système n’est pas disponible sur ce Mac."
          }
        }
      }
    },
    "spaceActionFailed": {
      "comment": "Native system Space shortcut dependency; settings are read, never changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare the Space shortcut. In System Settings → Keyboard → Keyboard Shortcuts → Mission Control, enable Control + Left/Right Arrow for moving between Spaces. Disabled or customized shortcuts are not sent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить сочетание для рабочего стола. В «Системные настройки» → «Клавиатура» → «Сочетания клавиш» → Mission Control включите Control + стрелка влево/вправо для перехода между рабочими столами. Отключённые или изменённые сочетания не отправляются."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Space-Kurzbefehl konnte nicht vorbereitet werden. Aktivieren Sie Control + Pfeil links/rechts für den Space-Wechsel unter Systemeinstellungen → Tastatur → Tastaturkurzbefehle → Mission Control. Deaktivierte oder angepasste Kurzbefehle werden nicht gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer le raccourci de bureau. Dans Réglages Système → Clavier → Raccourcis clavier → Mission Control, activez Contrôle + flèche gauche/droite pour changer de bureau. Les raccourcis désactivés ou personnalisés ne sont pas envoyés."
          }
        }
      }
    },
    "spaceActionHint": {
      "comment": "Native system Space shortcut dependency; settings are read, never changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the standard Control + Left/Right Arrow shortcut. macOS handles the transition, screen selection and first/last desktop, respecting Reduce Motion. Enable these shortcuts in System Settings → Keyboard → Keyboard Shortcuts → Mission Control. Custom Space shortcuts are not supported yet. System settings are not changed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует штатное сочетание Control + стрелка влево/вправо. macOS управляет переходом, выбором экрана и границами рабочих столов с учётом уменьшения движения. Включите эти сочетания в «Системные настройки» → «Клавиатура» → «Сочетания клавиш» → Mission Control. Изменённые сочетания для рабочих столов пока не поддерживаются. Настройки системы не изменяются."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Control + Pfeil links/rechts. macOS steuert Übergang, Bildschirmauswahl und den ersten/letzten Schreibtisch und berücksichtigt „Bewegung reduzieren“. Aktivieren Sie diese Kurzbefehle unter Systemeinstellungen → Tastatur → Tastaturkurzbefehle → Mission Control. Angepasste Space-Kurzbefehle werden noch nicht unterstützt. Systemeinstellungen werden nicht geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le raccourci standard Contrôle + flèche gauche/droite. macOS gère la transition, le choix de l’écran et les limites des bureaux, en respectant « Réduire les animations ». Activez ces raccourcis dans Réglages Système → Clavier → Raccourcis clavier → Mission Control. Les raccourcis de bureau personnalisés ne sont pas encore pris en charge. Les réglages système ne sont pas modifiés."
          }
        }
      }
    },
    "spaceActionUnavailable": {
      "comment": "Native system Space shortcut dependency; settings are read, never changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space navigation requires the enabled standard Control + Left/Right Arrow shortcuts in Mission Control settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для переходов нужны включённые штатные сочетания Control + стрелка влево/вправо в настройках Mission Control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Space-Wechsel erfordert die aktivierten Standardkurzbefehle Control + Pfeil links/rechts in den Mission-Control-Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de bureau nécessite les raccourcis standard Contrôle + flèche gauche/droite activés dans les réglages de Mission Control."
          }
        }
      }
    },
    "storageLockedLanguage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language cannot be changed while configuration recovery is required."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для смены языка сначала восстановите конфигурацию."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache kann erst nach der Wiederherstellung der Konfiguration geändert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablissez la configuration avant de changer de langue."
          }
        }
      }
    },
    "storageUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguration nicht lesbar. Bearbeitung zum Schutz der Datei gesperrt. Prüfen Sie ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration could not be read. Editing is locked to preserve the file. Check ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration illisible. Modification bloquée pour préserver le fichier. Vérifiez ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать настройки. Изменения заблокированы для сохранности файла. Проверьте ~/Library/Application Support/Rebind/configuration.json."
          }
        }
      }
    },
    "storageWriteFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
