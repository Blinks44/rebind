    "recordingLimitations": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine physische Taste, mittlere/zusätzliche Maustaste oder Scrollrichtung mit optionalen Modifikatoren aufnehmen. Für Bewegung mit Taste die Taste aufnehmen und die Richtung separat wählen. Feststelltaste, einzelne Modifikatoren, Fn und Multitouch werden nicht unterstützt. Escape bricht die Aufnahme ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a physical key, middle/extra mouse button or wheel direction with optional modifiers. For button movement, record the button and choose the direction separately. Caps Lock, modifier-only keys, Fn and multitouch are not supported. Escape cancels recording."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une touche physique, un bouton central/supplémentaire ou une direction de molette avec des modificateurs facultatifs. Pour un mouvement avec bouton, enregistrez le bouton et choisissez la direction séparément. Verr. maj., modificateurs seuls, Fn et multitouch ne sont pas pris en charge. Échap annule l’enregistrement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите физическую клавишу, среднюю/дополнительную кнопку мыши или направление колеса с модификаторами. Для движения с кнопкой запишите кнопку и отдельно выберите направление. Caps Lock, отдельные модификаторы, Fn и мультитач пока не поддерживаются. Escape отменяет запись."
          }
        }
      }
    },
