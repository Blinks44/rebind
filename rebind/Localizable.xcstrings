    "eventPostingRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen sind erlaubt. Das Senden von Ereignissen muss noch erlaubt werden. Klicken Sie im Hauptfenster auf „Senden von Ereignissen erlauben“ und starten Sie Rebind bei Aufforderung neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility is allowed, but Rebind still cannot send shortcuts and clicks. Choose Allow Event Sending in the main window and reopen Rebind if macOS asks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibilité est autorisée. L’envoi d’événements doit encore être autorisé. Cliquez sur « Autoriser l’envoi d’événements » dans la fenêtre principale, puis relancez Rebind si macOS le demande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ разрешён, но Rebind пока не может отправлять сочетания клавиш и щелчки. Нажмите «Разрешить отправку событий» в главном окне и перезапустите Rebind, если macOS попросит."
          }
        }
      }
    },
    "eventPostingStatus" : {
      "extractionState" : "manual",
