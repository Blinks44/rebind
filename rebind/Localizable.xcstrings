    "addBindingHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Belegung hinzufügen, um Eingabe und Ausgabekombination zu erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a binding to record input and choose an output shortcut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une règle pour enregistrer une entrée et un raccourci de sortie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте правило, чтобы записать ввод и выходное сочетание клавиш."
          }
        }
      }
    },
