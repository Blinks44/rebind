    "phaseOneHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionen: Tastenkombinationen, Mausklicks, verfügbare Audio- und Wiedergabesteuerung, Fenster- und Programmaktionen, Öffnen von Programmen, Webadressen und Dateien sowie Apple-Kurzbefehle. Direkte Mission-Control-Aktionen sind experimentell; Space-Wechsel verwenden Standard-Systemkurzbefehle. Multitouch ist geplant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions: keyboard shortcuts, mouse clicks, available sound and playback controls, supported window/app operations, opening apps/web addresses/files, and Apple Shortcuts. Direct Mission Control actions are experimental; Space navigation uses standard system shortcuts. Multitouch is planned."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions : raccourcis clavier, clics de souris, commandes audio et de lecture disponibles, opérations sur les fenêtres et applications, ouverture d’applications, d’adresses web et de fichiers, et raccourcis Apple. Les actions directes de Mission Control sont expérimentales ; le changement de bureau utilise les raccourcis système standard. Le multitouch est prévu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия: сочетания клавиш, клики мыши, доступное управление звуком и воспроизведением, операции с окнами и приложениями, открытие приложений, веб-адресов и файлов, быстрые команды Apple. Прямые действия Mission Control экспериментальные; переходы между рабочими столами используют штатные сочетания системы. Мультитач появится позже."
          }
        }
      },
      "comment": "Currently implemented action categories."
    },
