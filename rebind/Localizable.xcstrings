    "trackpadInputDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four-finger tap → shortcut, without modifiers. Native gestures remain active and may also respond. Other gestures are not available yet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Касание четырьмя пальцами → сочетание клавиш, без модификаторов. Системные жесты остаются активными и могут сработать одновременно. Другие жесты пока недоступны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen mit vier Fingern → Tastenkombination, ohne Zusatztasten. Systemgesten bleiben aktiv und können gleichzeitig reagieren. Andere Gesten sind noch nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher avec quatre doigts → raccourci, sans touches de modification. Les gestes système restent actifs et peuvent aussi réagir. Les autres gestes ne sont pas encore disponibles."
          }
        }
      }
    },
    "trackpadLookUpHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If three-finger Look Up is enabled, macOS may also respond. In System Settings → Trackpad → Point & Click, change Look up & data detectors, or choose another preset. Rebind does not suppress system gestures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включен поиск касанием тремя пальцами, macOS тоже может отреагировать. Измените «Поиск и детекторы данных» в Системных настройках → Трекпад → Выбор и нажатие или выберите другой жест. Rebind не подавляет системные жесты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Nachschlagen mit drei Fingern aktiviert ist, kann macOS ebenfalls reagieren. Ändern Sie Nachschlagen & Datenerkennung unter Systemeinstellungen → Trackpad → Zeigen & Klicken oder wählen Sie eine andere Geste. Rebind unterdrückt Systemgesten nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la recherche avec trois doigts est activée, macOS peut aussi réagir. Modifiez Recherche et détection de données dans Réglages Système → Trackpad → Pointer et cliquer, ou choisissez un autre geste. Rebind ne bloque pas les gestes système."
          }
        }
      },
      "comment": "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings."
    },
    "trackpadNotAvailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad-Gesten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad gestures"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestes du trackpad"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты трекпада"
          }
        }
      }
    },
    "trackpadOutputHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records the output only. No action runs while editing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывается только выходное сочетание. При редактировании действия не выполняются."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das Ausgabekürzel wird aufgezeichnet. Beim Bearbeiten wird keine Aktion ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le raccourci de sortie est enregistré. Aucune action ne s’exécute pendant la modification."
          }
        }
      },
      "comment": "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings."
    },
    "trackpadSystemGestureHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind does not suppress system gestures. If macOS also responds, review Trackpad gestures in System Settings or choose another preset."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind не подавляет системные жесты. Если macOS тоже реагирует, проверьте жесты трекпада в Системных настройках или выберите другой жест."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind unterdrückt Systemgesten nicht. Wenn macOS ebenfalls reagiert, prüfen Sie die Trackpad-Gesten in den Systemeinstellungen oder wählen Sie eine andere Geste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind ne bloque pas les gestes système. Si macOS réagit aussi, vérifiez les gestes du trackpad dans Réglages Système ou choisissez un autre geste."
          }
        }
      },
      "comment": "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings."
    },
    "trackpadSystemGestureWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System gestures may also run"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные жесты тоже могут сработать"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemgesten können ebenfalls ausgeführt werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestes système peuvent aussi se déclencher"
          }
        }
      },
      "comment": "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings."
    },
    "trackpadTapHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single and double taps with 3 or 4 fingers send keyboard shortcuts on the built-in trackpad. System gestures remain active. If a double-tap rule is enabled, its single tap waits for the system double-click interval."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одиночные и двойные тапы тремя или четырьмя пальцами отправляют сочетания клавиш со встроенного трекпада. Системные жесты остаются активны. Если включено правило двойного тапа, одиночный тап ожидает системный интервал двойного клика."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfaches und doppeltes Tippen mit drei oder vier Fingern sendet Tastenkürzel über das integrierte Trackpad. Systemgesten bleiben aktiv. Bei aktivierter Doppeltipp-Regel wartet der einfache Tipp das Systemintervall für Doppelklicks ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touchers simples et doubles à trois ou quatre doigts envoient des raccourcis depuis le trackpad intégré. Les gestes système restent actifs. Si une règle de double toucher est activée, le toucher simple attend le délai système du double clic."
          }
        }
      },
      "comment": "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings."
    },
    "trackpadThreeFingerDoubleTapHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap twice with 3 fingers without pressing the trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь трекпада тремя пальцами дважды, не нажимая на него."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie zweimal mit drei Fingern, ohne das Trackpad zu drücken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois avec trois doigts sans appuyer sur le trackpad."
          }
        }
      },
      "comment": "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings."
    },
    "trackpadThreeFingerTapHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap once with 3 fingers without pressing the trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь трекпада тремя пальцами один раз, не нажимая на него."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie einmal mit drei Fingern, ohne das Trackpad zu drücken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une fois avec trois doigts sans appuyer sur le trackpad."
          }
        }
      },
      "comment": "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings."
    },
    "trackpadUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in trackpad capture is unavailable on this Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват встроенного трекпада недоступен на этом Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassung des integrierten Trackpads auf diesem Mac nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture du trackpad intégré est indisponible sur ce Mac."
          }
        }
      }
    },
    "trackpadZoomHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If trackpad zoom is enabled, macOS may also respond. In System Settings → Accessibility → Zoom, review Use trackpad gesture to zoom, or choose another preset. Rebind does not suppress system gestures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено увеличение жестом трекпада, macOS тоже может отреагировать. Проверьте эту опцию в Системных настройках → Универсальный доступ → Увеличение или выберите другой жест. Rebind не подавляет системные жесты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Zoomen per Trackpad-Geste aktiviert ist, kann macOS ebenfalls reagieren. Prüfen Sie Trackpad-Geste zum Zoomen verwenden unter Systemeinstellungen → Bedienungshilfen → Zoom oder wählen Sie eine andere Geste. Rebind unterdrückt Systemgesten nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le zoom par geste du trackpad est activé, macOS peut aussi réagir. Vérifiez Utiliser le geste du trackpad pour zoomer dans Réglages Système → Accessibilité → Zoom, ou choisissez un autre geste. Rebind ne bloque pas les gestes système."
          }
        }
      },
      "comment": "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings."
    },
