    "spaceActionFailed" : {
      "comment" : "Native system Space shortcut dependency; settings are read, never changed.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schreibtisch konnte nicht gewechselt werden. Aktivieren Sie unter Systemeinstellungen → Tastatur → Tastaturkurzbefehle → Mission Control die Kurzbefehle ctrl + Pfeil links/rechts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not switch desktops. In System Settings → Keyboard → Keyboard Shortcuts → Mission Control, turn on the Control + Left/Right Arrow shortcuts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de changer de bureau. Dans Réglages Système → Clavier → Raccourcis clavier → Mission Control, activez les raccourcis Contrôle + Flèche gauche/droite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось переключить рабочий стол. В разделе «Системные настройки» → «Клавиатура» → «Сочетания клавиш» → Mission Control включите сочетания Control + стрелка влево/вправо."
          }
        }
      }
    },
    "spaceActionHint" : {
      "comment" : "Native system Space shortcut dependency; settings are read, never changed.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt den Schreibtisch wie ctrl + Pfeil links/rechts. Diese Kurzbefehle müssen unter Systemeinstellungen → Tastatur → Tastaturkurzbefehle → Mission Control aktiviert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches desktops the same way Control + Left/Right Arrow does. Those shortcuts must be turned on in System Settings → Keyboard → Keyboard Shortcuts → Mission Control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change de bureau comme Contrôle + Flèche gauche/droite. Ces raccourcis doivent être activés dans Réglages Système → Clavier → Raccourcis clavier → Mission Control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключает рабочие столы так же, как Control + стрелка влево/вправо. Эти сочетания должны быть включены в разделе «Системные настройки» → «Клавиатура» → «Сочетания клавиш» → Mission Control."
          }
        }
      }
    },
