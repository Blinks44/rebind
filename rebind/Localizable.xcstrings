    "advancedProtectedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file could not be loaded. The original is preserved. Import and reset are unavailable until it is recovered."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить файл. Оригинал сохранён. Импорт и сброс недоступны до восстановления."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht geladen werden. Das Original bleibt erhalten. Import und Zurücksetzen sind bis zur Wiederherstellung nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’a pas pu être chargé. L’original est conservé. L’importation et la réinitialisation sont indisponibles jusqu’à sa récupération."
          }
        }
      }
    },
