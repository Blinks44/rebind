      }
    },
    "signingHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local development builds may require granting access again after rebuilding. Relaunch if macOS requests it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После пересборки локальной версии может потребоваться повторное разрешение. Перезапустите приложение, если macOS попросит."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Entwicklungsbuilds können nach dem Neubau erneut Zugriff benötigen. Bei Aufforderung durch macOS neu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après compilation locale, les autorisations peuvent devoir être accordées à nouveau. Relancez si macOS le demande."
          }
        }
      }
    },
    "recordingLimitations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a physical key with optional modifiers, or a middle/extra mouse button. Caps Lock, modifier-only keys, Fn and gestures are not supported in this slice. Escape cancels recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите физическую клавишу с модификаторами либо среднюю/дополнительную кнопку мыши. Caps Lock, отдельные модификаторы, Fn и жесты пока не поддерживаются. Escape отменяет запись."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine physische Taste mit optionalen Modifikatoren oder eine mittlere/zusätzliche Maustaste drücken. Caps Lock, reine Modifikatortasten, Fn und Gesten werden noch nicht unterstützt. Escape bricht ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une touche avec des modificateurs facultatifs, ou sur un bouton central/supplémentaire de la souris. Verr. maj., modificateurs seuls, Fn et gestes ne sont pas encore pris en charge. Échap annule."
          }
        }
      }
    },
