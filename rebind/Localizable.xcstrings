    "advancedResetConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All profiles and bindings will be removed. App preferences return to defaults and remapping stays paused. This cannot be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все профили и привязки будут удалены. Настройки приложения вернутся к исходным значениям, переназначения останутся на паузе. Это нельзя отменить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Profile und Belegungen werden entfernt. Die App-Einstellungen werden zurückgesetzt und die Neubelegung bleibt pausiert. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les profils et associations seront supprimés. Les réglages seront rétablis et le remappage restera en pause. Cette action est irréversible."
          }
        }
      }
    },
    "advancedResetConfirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset all profiles and bindings?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить все профили и привязки?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Profile und Belegungen zurücksetzen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser tous les profils et associations ?"
          }
        }
      }
    },
    "advancedResetDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all profiles and bindings and restore app preferences. Export a backup first."
          }
        },
        "ru": {
