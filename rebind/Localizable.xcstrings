    "eventPostingRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen sind erlaubt. Das Senden von Ereignissen muss noch erlaubt werden. Klicken Sie im Hauptfenster auf „Senden von Ereignissen erlauben“ und starten Sie Rebind bei Aufforderung neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility is granted. Event sending still needs authorization. Use Allow Event Sending in the main window, then relaunch if macOS asks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibilité est autorisée. L’envoi d’événements doit encore être autorisé. Cliquez sur « Autoriser l’envoi d’événements » dans la fenêtre principale, puis relancez Rebind si macOS le demande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Универсальный доступ» разрешён. Нужно разрешить отправку событий: нажмите «Разрешить отправку событий» в главном окне и перезапустите Rebind, если macOS попросит."
          }
        }
      }
    },
    "eventPostingStatus" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Senden von Ereignissen ist nicht erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event sending is not authorized."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi d’événements n’est pas autorisé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не разрешена отправка событий."
          }
        }
      }
    },
    "eventSendingPurpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen sind aktiviert. macOS benötigt noch die Erlaubnis, Tastenkombinationen und Klicks an andere Apps zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility is enabled. macOS still needs permission to send shortcuts and clicks to other apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accessibilité est activée. macOS a encore besoin d’une autorisation pour envoyer des raccourcis et clics aux autres apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ включён. macOS ещё требуется разрешение на отправку сочетаний клавиш и щелчков в другие приложения."
          }
        }
      }
    },
    "eventSendingSteps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls der Zugriff weiter fehlt, prüfe Rebind unter Bedienungshilfen. Beende und öffne Rebind erneut, wenn macOS dich dazu auffordert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If access stays unavailable, check Rebind in Accessibility. Quit and reopen Rebind if macOS asks you to."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’accès reste indisponible, vérifiez Rebind dans Accessibilité. Quittez puis rouvrez Rebind si macOS vous le demande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если доступ по-прежнему недоступен, проверьте Rebind в разделе «Универсальный доступ». Если macOS попросит, закройте и снова откройте Rebind."
          }
        }
      }
    },
