    "deleteBindingConfirmation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Belegung löschen? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this binding? This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette règle ? Cette action est irréversible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить это правило? Это действие нельзя отменить."
          }
        }
      }
    },
    "deviceScopeHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegungen gelten für die gesamte Kategorie. Maustaste 4 entspricht Quartz-Index 3. Gerätezuordnung und Gesten erfordern weitere Prüfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category-wide rules only. Mouse Button 4 means Quartz index 3. Per-device rules and gestures await verification."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles par catégorie uniquement. Bouton 4 correspond à l’indice Quartz 3. Règles par appareil et gestes en attente de vérification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила для всей категории устройств. Кнопка мыши 4 — индекс Quartz 3. Привязка к отдельным устройствам и жесты ожидают проверки."
          }
        }
      }
    },
    "disableBinding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegung deaktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable Binding"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
