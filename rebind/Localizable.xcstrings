      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Lautstärke der aktuellen Tonausgabe in kleinen Schritten. Stummgeschalteter Ton bleibt stumm. Manche Ausgaben erlauben weder Lautstärkeregelung noch Stummschaltung."
          }
        },
        "en" : {
