    },
    "diagnosticsHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Maustasten und Mausrad; Tastaturereignisse, Text und Zeigerkoordinaten sind ausgeschlossen. Quartz-Tastencodes beginnen bei 0. Regeln bleiben aktiv. „In Warteschlange“ bestätigt die Übergabe an die Engine, nicht die Zustellung an eine andere App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse buttons and wheel only; keyboard events, text and pointer coordinates are excluded. Quartz button codes start at 0. Rules remain active. “Queued” confirms handoff to the engine, not delivery to another app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boutons de souris et molette uniquement ; événements clavier, texte et coordonnées du pointeur exclus. Les codes Quartz commencent à 0. Les règles restent actives. « En attente » confirme le transfert au moteur, pas la réception par une autre app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только кнопки мыши и колесо: события клавиатуры, текст и координаты указателя исключены. Коды кнопок Quartz начинаются с 0. Правила продолжают действовать. «В очереди» означает передачу движку, а не доставку в другое приложение."
          }
        }
      }
    },
    "diagnosticsInput": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input"
