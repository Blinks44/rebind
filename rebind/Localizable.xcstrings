          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@” and all its rules? Other profiles will be preserved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%@» и все его правила? Другие профили будут сохранены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und alle zugehörigen Regeln löschen? Andere Profile bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » et toutes ses règles ? Les autres profils seront conservés."
          }
        }
      }
    },
    "deviceScopeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules apply to the entire input category in the active profile. Mouse Button 4 is Quartz index 3. Touch gestures require further verification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила действуют для всей категории ввода в активном профиле. Кнопка мыши 4 — индекс Quartz 3. Мультитач ожидает проверки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln gelten für die gesamte Eingabekategorie im aktiven Profil. Maustaste 4 ist Quartz-Index 3. Touch-Gesten müssen noch geprüft werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles s’appliquent à toute la catégorie dans le profil actif. Le bouton souris 4 correspond à l’indice Quartz 3. Les gestes tactiles restent à vérifier."
          }
        }
      }
    },
