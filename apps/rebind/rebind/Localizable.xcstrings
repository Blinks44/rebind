    "holdDurationDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie so lange gedrückt, um die Aktion einmal auszuführen. Früheres Loslassen bricht sie ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep pressed for this long to run the action once. Releasing earlier cancels the action."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez l’appui pendant cette durée pour exécuter l’action une fois. Relâcher plus tôt l’annule."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте столько времени, чтобы выполнить действие один раз. Если отпустить раньше, действие отменится."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado este tiempo para ejecutar la acción una vez. Si sueltas antes, se cancela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住这么长时间即可执行一次操作。提前松开则取消。"
          }
        }
      }
    },
    "holdDurationTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
