        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le bouton central ou un bouton supplémentaire, avec des touches de modification si vous le souhaitez. Les boutons gauche et droit ne peuvent pas être réaffectés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите среднюю или дополнительную кнопку, при желании с клавишами-модификаторами. Левую и правую кнопки переназначить нельзя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba el botón central o un botón adicional, con teclas modificadoras si quieres. Los botones izquierdo y derecho no se pueden reasignar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
