    "sleepSystemHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versetzt den Mac in den Ruhezustand. Das anschließende Loslassen der Taste oder Maustaste kann ihn wieder aufwecken. Ob ein Passwort nötig ist, hängt von Ihren Einstellungen ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts the Mac to sleep. Releasing the key or button afterwards may wake it again. Whether a password is needed depends on your settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met le Mac en veille. Relâcher ensuite la touche ou le bouton peut le réactiver. La demande de mot de passe dépend de vos réglages."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переводит Mac в режим сна. Если после этого отпустить клавишу или кнопку, Mac может снова проснуться. Запрос пароля зависит от ваших настроек."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone el Mac en reposo. Soltar después la tecla o el botón puede volver a activarlo. Que se pida contraseña depende de tus ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Mac 进入睡眠。之后松开按键或按钮可能会再次唤醒它。是否需要密码取决于你的设置。"
          }
        }
      }
    },
