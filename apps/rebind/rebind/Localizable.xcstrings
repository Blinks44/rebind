    "nextDisplayHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt das Fenster im Vordergrund auf das nächste Display und behält seine Größe, sofern sie passt. Benötigt mindestens zwei Displays; funktioniert nicht im Vollbildmodus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the window in front to the next display and keeps its size where it fits. Needs at least two displays; it does not work in full screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la ventana en primer plano a la siguiente pantalla y conserva su tamaño si cabe. Necesita al menos dos pantallas; no funciona en pantalla completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace la fenêtre au premier plan vers l’écran suivant en conservant sa taille si elle tient. Nécessite au moins deux écrans ; ne fonctionne pas en plein écran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещает окно на переднем плане на следующий экран и сохраняет его размер, если он помещается. Нужно минимум два экрана; в полноэкранном режиме не работает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将最前面的窗口移到下一个显示器，并在放得下时保持其大小。至少需要两个显示器；全屏幕下无效。"
          }
        }
      }
    },
