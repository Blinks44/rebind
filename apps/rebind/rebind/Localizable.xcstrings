          "stringUnit" : {
            "state" : "translated",
            "value" : "This binding replaces the right-click on the trackpad. It works when Secondary click is set to Click with Two Fingers in System Settings → Trackpad → Point & Click."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette règle remplace le clic secondaire du trackpad. Elle fonctionne lorsque le clic secondaire est réglé sur « Cliquer avec deux doigts » dans Réglages Système → Trackpad → Pointer et cliquer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правило заменяет имитацию правой кнопки на трекпаде. Оно работает, если в разделе «Системные настройки» → «Трекпад» → «Выбор и нажатие» для имитации правой кнопки выбрано нажатие двумя пальцами."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regla sustituye al clic derecho del trackpad. Funciona si en Ajustes del Sistema → Trackpad → Señalar y hacer clic, el clic secundario está configurado como “Hacer clic con dos dedos”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此规则会取代触控板上的右键点按。需要在“系统设置”→“触控板”→“光标与点按”中将辅助点按设为“双指点按”。"
          }
        }
      }
    },
    "trackpadSmartZoomHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Intelligentes Zoomen aktiviert ist, reagiert macOS ebenfalls. Deaktivieren Sie es unter Systemeinstellungen → Trackpad → Scrollen & Zoomen oder wählen Sie eine andere Geste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Smart zoom is on, macOS responds as well. Turn it off in System Settings → Trackpad → Scroll & Zoom, or choose another gesture."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le zoom intelligent est activé, macOS réagit aussi. Désactivez-le dans Réglages Système → Trackpad → Défilement et zoom, ou choisissez un autre geste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено смарт-масштабирование, macOS тоже отреагирует. Отключите его в разделе «Системные настройки» → «Трекпад» → «Прокрутка и масштабирование» или выберите другой жест."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el zoom inteligente está activado, macOS también responde. Desactívalo en Ajustes del Sistema → Trackpad → Desplazamiento y zoom, o elige otro gesto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果开启了智能缩放，macOS 也会响应。请在“系统设置”→“触控板”→“滚动缩放”中将其关闭，或选择其他手势。"
          }
        }
      }
    },
    "trackpadSubtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festlegen, was jedes Tippen oder Klicken bewirkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what each tap or click does."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l’action de chaque toucher ou clic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что делает каждое касание или нажатие."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué hace cada toque o clic."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择每次轻点或点按的作用。"
          }
        }
      }
    },
    "trackpadSystemGestureHelp" : {
      "comment" : "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS reagiert möglicherweise ebenfalls auf diese Geste. Prüfen Sie in diesem Fall die Gesten unter Systemeinstellungen → Trackpad oder wählen Sie eine andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS may respond to this gesture too. If it does, review the gestures in System Settings → Trackpad or choose another one."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS peut aussi réagir à ce geste. Dans ce cas, vérifiez les gestes dans Réglages Système → Trackpad ou choisissez-en un autre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS тоже может реагировать на этот жест. Если так и происходит, проверьте жесты в разделе «Системные настройки» → «Трекпад» или выберите другой жест."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS también puede responder a este gesto. Si lo hace, revisa los gestos en Ajustes del Sistema → Trackpad o elige otro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 也可能响应此手势。如果是这样，请在“系统设置”→“触控板”中检查手势，或选择其他手势。"
          }
        }
      }
    },
