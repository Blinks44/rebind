    "advancedResetConfirmBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Profile und Belegungen werden entfernt. Die App-Einstellungen werden zurückgesetzt und die Belegungen bleiben pausiert. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All profiles and bindings will be removed. App settings return to their defaults and bindings stay paused. This cannot be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les profils et toutes les règles seront supprimés. Les réglages de l’app seront rétablis et les règles resteront en pause. Cette action est irréversible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все профили и правила будут удалены. Настройки приложения вернутся к исходным, правила останутся на паузе. Это действие нельзя отменить."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los perfiles y reglas. Los ajustes de la app volverán a sus valores por omisión y las reglas seguirán en pausa. Esta acción no se puede deshacer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有配置文件和规则都将被移除。App 设置会恢复为默认值，规则保持暂停。此操作无法撤销。"
          }
        }
      }
    },
