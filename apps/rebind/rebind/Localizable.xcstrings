        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind n’a pas pu commencer à lire les entrées. Mettez les règles en pause, vérifiez les autorisations, puis réactivez-les."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
