    "mouseButtonHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfassen Sie die mittlere oder eine zusätzliche Taste, auf Wunsch mit Sondertasten. Linke und rechte Taste lassen sich nicht neu belegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record the middle button or an extra button, with modifier keys if you like. The left and right buttons cannot be reassigned."
