    "bindingAppHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Belegung für eine App gilt nur, solange sie im Vordergrund ist, und ersetzt dort eine Belegung für alle Apps mit demselben Auslöser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rule for one app works only while it is in front, and replaces a rule for all apps with the same trigger there."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une règle pour une app ne fonctionne que lorsqu’elle est au premier plan, et y remplace une règle pour toutes les apps avec le même déclencheur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правило для одного приложения работает, только пока оно на переднем плане, и заменяет там правило для всех приложений с тем же триггером."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una regla para una app solo funciona mientras está en primer plano y allí sustituye a una regla para todas las apps con el mismo activador."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "针对单个 App 的规则仅在该 App 位于前台时生效，并取代输入相同的通用规则。"
          }
        }
      }
    },
