    "holdDurationDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Taste oder Maustaste so lange gedrückt, um die Aktion einmal auszuführen. Früheres Loslassen bricht sie ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the key or button for this long to run the action once. Releasing earlier cancels it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez l’appui pendant cette durée pour exécuter l’action une fois. Relâcher plus tôt l’annule."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте клавишу или кнопку указанное время, чтобы действие сработало один раз. Если отпустить раньше, оно отменится."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la tecla o el botón durante este tiempo para ejecutar la acción una vez. Si sueltas antes, se cancela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住这么长时间即可执行一次操作。提前松开则取消。"
          }
        }
      }
    },
    "holdDurationTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltedauer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold duration"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée de maintien"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время удержания"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住时长"
          }
        }
      }
    },
    "holdHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nach Ablauf der Haltedauer einmal ausgelöst. Früheres Loslassen, eine andere Taste oder Maustaste oder Scrollen bricht ab. Ein kurzer Druck wird nicht weitergegeben, es sei denn, Sie legen ein Kürzel für kurzes Drücken fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs once when the hold time is reached. Releasing early, pressing another key or button, or scrolling cancels it. A shorter press is not passed on unless you set a short-press shortcut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’exécute une fois la durée de maintien atteinte. Relâcher plus tôt, appuyer sur une autre touche ou un bouton, ou faire défiler annule l’action. Un appui court n’est transmis que si vous lui attribuez un raccourci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срабатывает один раз по истечении времени удержания. Если раньше отпустить, нажать другую клавишу или кнопку либо прокрутить, действие отменится. Короткое нажатие не передаётся приложениям, если для него не задано сочетание."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta una vez al alcanzar la duración elegida. Soltar antes, pulsar otra tecla o botón, o desplazarte cancela la acción. Una pulsación corta solo se transmite si le asignas un atajo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住达到所选时长后执行一次。提前松开、按下其他键或按钮、滚动都会取消操作。短按不会传给其他 App，除非为短按设置了快捷键。"
          }
        }
      }
    },
    "holdModifierHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt diese Sondertaste anderen Tasten, Klicks und dem Scrollen hinzu, solange Sie den Auslöser halten. Verwenden Sie eine Taste oder Maustaste mit „Drücken“ oder „Halten“. Rebinds eigene Belegungen ignorieren diese Sondertaste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds this modifier to other keys, clicks and scrolling while you hold the trigger. Use a key or mouse button with Press or Hold activation. Rebind’s own bindings ignore this modifier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade este modificador a otras teclas, clics y desplazamientos mientras mantienes el activador. Usa una tecla o un botón con «Pulsación» o «Mantener». Las reglas de Rebind ignoran este modificador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ce modificateur aux autres touches, clics et défilements tant que vous maintenez le déclencheur. Utilisez une touche ou un bouton avec « Appui » ou « Maintien ». Les règles de Rebind ignorent ce modificateur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет этот модификатор к другим клавишам, нажатиям мыши и прокрутке, пока вы удерживаете триггер. Подходит для клавиши или кнопки мыши со срабатыванием «Нажатие» или «Удержание». Правила Rebind этот модификатор не учитывают."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住触发器时，将此修饰键添加到其他按键、点按和滚动中。触发器须为按键或鼠标按钮，触发方式为“按下”或“按住”。Rebind 自己的规则会忽略此修饰键。"
          }
        }
      }
    },
