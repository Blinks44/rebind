    "advancedDiagnosticsBlocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung ist nicht verfügbar, solange die Belegungen angehalten sind, eine Berechtigung fehlt oder die sichere Eingabe aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording is unavailable while bindings are stopped, a permission is missing or Secure Input is on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement est indisponible tant que les règles sont arrêtées, qu’une autorisation manque ou que la saisie sécurisée est active."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись недоступна, пока правила остановлены, не хватает разрешений или включён безопасный ввод."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede grabar mientras las reglas estén detenidas, falte un permiso o la entrada segura esté activa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规则已停止、缺少权限或安全输入开启时，无法录制。"
          }
        }
      }
    },
