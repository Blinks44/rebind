          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind n’a pas pu lire son fichier de configuration ; la modification est verrouillée pour le protéger. Vérifiez ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind не смог прочитать файл конфигурации, поэтому редактирование заблокировано, чтобы его не повредить. Проверьте ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind no ha podido leer su archivo de configuración, así que la edición está bloqueada para protegerlo. Revisa ~/Library/Application Support/Rebind/configuration.json."
