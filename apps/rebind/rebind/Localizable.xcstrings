    "lightingLowBatteryDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below 10% and not charging. Your color comes back once it charges. Works while Rebind is running."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При заряде ниже 10 %, если клавиатура не заряжается. При зарядке выбранный цвет вернётся. Работает, пока запущен Rebind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter 10 % und ohne Ladevorgang. Beim Laden kehrt die gewählte Farbe zurück. Funktioniert, solange Rebind läuft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous 10 % et hors charge. La couleur choisie revient pendant la charge. Fonctionne lorsque Rebind est ouvert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por debajo del 10 % y sin cargar. El color elegido vuelve al cargar. Funciona mientras Rebind está abierto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电量低于 10% 且未充电时生效。充电后恢复所选颜色。仅在 Rebind 运行时有效。"
          }
        }
      }
    },
