    "externalTrackpadDisconnectedHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect an external trackpad to use these bindings. You can still edit them here. Built-in Trackpad bindings are separate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите внешний трекпад, чтобы использовать эти правила. Их по-прежнему можно редактировать. Для встроенного трекпада действуют отдельные правила."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie ein externes Trackpad, um diese Belegungen zu verwenden. Sie können sie weiterhin bearbeiten. Für das integrierte Trackpad gelten eigene Belegungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez un trackpad externe pour utiliser ces règles. Vous pouvez toujours les modifier ici. Le trackpad intégré possède ses propres règles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un trackpad externo para usar estas reglas. Puedes seguir editándolas aquí. El trackpad integrado tiene reglas independientes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接外置触控板后即可使用这些规则。你仍可在此编辑规则。内建触控板使用独立的规则。"
          }
        }
      }
    },
