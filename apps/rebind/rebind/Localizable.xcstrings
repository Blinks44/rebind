    "aboutDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasten und Mauseingaben mit macOS-Aktionen und Tastaturkurzbefehlen belegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
