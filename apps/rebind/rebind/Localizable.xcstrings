    "accessLostPurpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Belegungen sind angehalten, bleiben aber gespeichert. Tastatur und Maus funktionieren wie gewohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bindings have stopped, but your rules are saved. Your keyboard and mouse work as usual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles sont arrêtées, mais restent enregistrées. Le clavier et la souris continuent de fonctionner normalement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила перестали работать, но сохранены. Клавиатура и мышь работают как обычно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas están detenidas, pero siguen guardadas. El teclado y el ratón funcionan con normalidad."
          }
