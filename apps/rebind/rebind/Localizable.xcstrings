    "spaceActionFailed" : {
      "comment" : "Native system Space shortcut dependency; settings are read, never changed.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schreibtisch konnte nicht gewechselt werden. Aktivieren Sie unter Systemeinstellungen → Tastatur → Tastaturkurzbefehle → Mission Control die Tastaturkurzbefehle ctrl + Pfeil links/rechts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not switch desktops. In System Settings → Keyboard → Keyboard Shortcuts → Mission Control, turn on the Control + Left/Right Arrow shortcuts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de changer de bureau. Dans Réglages Système → Clavier → Raccourcis clavier → Mission Control, activez les raccourcis Contrôle + Flèche gauche/droite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось переключить рабочий стол. В разделе «Системные настройки» → «Клавиатура» → «Сочетания клавиш» → Mission Control включите сочетания Control + стрелка влево/вправо."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido cambiar de escritorio. En Ajustes del Sistema → Teclado → Funciones rápidas de teclado → Mission Control, activa las funciones rápidas Control + Flecha izquierda/derecha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换桌面。请在“系统设置”→“键盘”→“键盘快捷键”→“调度中心”中打开 Control + 左/右箭头快捷键。"
          }
        }
      }
    },
    "spaceActionHint" : {
      "comment" : "Native system Space shortcut dependency; settings are read, never changed.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt den Schreibtisch wie ctrl + Pfeil links/rechts. Diese Tastaturkurzbefehle müssen unter Systemeinstellungen → Tastatur → Tastaturkurzbefehle → Mission Control aktiviert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches desktops the same way Control + Left/Right Arrow does. Those shortcuts must be turned on in System Settings → Keyboard → Keyboard Shortcuts → Mission Control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change de bureau comme Contrôle + Flèche gauche/droite. Ces raccourcis doivent être activés dans Réglages Système → Clavier → Raccourcis clavier → Mission Control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключает рабочие столы так же, как Control + стрелка влево/вправо. Эти сочетания должны быть включены в разделе «Системные настройки» → «Клавиатура» → «Сочетания клавиш» → Mission Control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia de escritorio igual que Control + Flecha izquierda/derecha. Esas funciones rápidas deben estar activadas en Ajustes del Sistema → Teclado → Funciones rápidas de teclado → Mission Control."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换桌面的方式与 Control + 左/右箭头相同。这些快捷键必须在“系统设置”→“键盘”→“键盘快捷键”→“调度中心”中打开。"
          }
        }
      }
    },
