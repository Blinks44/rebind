    "mouseButtonHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfassen Sie die mittlere oder eine zusätzliche Taste, auf Wunsch mit Sondertasten. Linke und rechte Taste lassen sich nicht neu belegen."
