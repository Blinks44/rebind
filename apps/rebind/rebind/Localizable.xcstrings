    "backgroundDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie dieses Fenster schließen, bleibt Rebind in der Menüleiste. Öffnen Sie es dort, um Belegungen zu verwalten oder zu pausieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you close this window, Rebind stays in the menu bar. Open it there to manage bindings or pause them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous fermez cette fenêtre, Rebind reste dans la barre des menus. Ouvrez-le depuis cette barre pour gérer les règles ou les mettre en pause."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы закрываете окно, Rebind остаётся в строке меню. Оттуда можно открыть правила или поставить их на паузу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar esta ventana, Rebind permanece en la barra de menús. Ábrelo desde allí para gestionar las reglas o ponerlas en pausa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
