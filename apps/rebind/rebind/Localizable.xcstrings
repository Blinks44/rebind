    "advancedConfigurationDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportieren Sie alle Einstellungen, Profile und Belegungen oder importieren Sie ein Backup. Außerdem sichert Rebind beim Start eine Kopie der Konfiguration, wenn sie sich geändert hat, und behält die letzten 10 Kopien. Import und Zurücksetzen erfordern eine Bestätigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export all settings, profiles and bindings, or import a backup. Rebind also saves a copy of the configuration at launch when it has changed and keeps the last 10 copies. Importing or resetting asks for confirmation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez tous les réglages, profils et règles, ou importez une sauvegarde. Au lancement, Rebind enregistre aussi une copie de la configuration si elle a changé et conserve les 10 dernières. L’importation et la réinitialisation demandent confirmation."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните все настройки, профили и правила в файл или восстановите их из копии. Кроме того, при запуске Rebind сохраняет копию конфигурации, если она изменилась, и хранит последние 10 копий. Перед импортом или сбросом появится запрос подтверждения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta todos los ajustes, perfiles y reglas, o importa una copia de seguridad. Además, al iniciarse, Rebind guarda una copia de la configuración si ha cambiado y conserva las 10 últimas. La importación y el restablecimiento requieren confirmación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出所有设置、配置文件和规则，或导入备份。此外，Rebind 每次启动时如发现配置有变化，会自动保存一份副本，并保留最近 10 份。导入或还原前会要求确认。"
          }
        }
      }
    },
