    "navigationActionHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends ⌘[ or ⌘], which most apps use for Back and Forward: Finder, Safari and other browsers, Xcode and more."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет ⌘[ или ⌘]: так «Назад» и «Вперёд» работают в большинстве приложений: Finder, Safari и других браузерах, Xcode и не только."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet ⌘[ oder ⌘] – damit funktionieren „Zurück“ und „Vorwärts“ in den meisten Apps: Finder, Safari und anderen Browsern, Xcode und weiteren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie ⌘[ ou ⌘], que la plupart des apps utilisent pour Précédent et Suivant : Finder, Safari et les autres navigateurs, Xcode, etc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía ⌘[ o ⌘], que la mayoría de las apps usan para Atrás y Adelante: Finder, Safari y otros navegadores, Xcode y más."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送 ⌘[ 或 ⌘]，大多数 App 用它们来后退和前进：访达、Safari 浏览器及其他浏览器、Xcode 等。"
          }
        }
      }
    },
