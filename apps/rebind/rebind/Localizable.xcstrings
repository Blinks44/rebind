    "holdOutputRepeatHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aktion wiederholt sich, solange Sie den Auslöser gedrückt halten, mit der Tastenwiederholrate Ihrer Tastatur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The action repeats for as long as you hold the trigger, at your keyboard’s key repeat rate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La acción se repite mientras mantienes pulsado el activador, a la velocidad de repetición del teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’action se répète tant que vous maintenez le déclencheur, à la vitesse de répétition de votre clavier."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действие повторяется, пока вы удерживаете триггер, с частотой автоповтора клавиатуры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住触发器期间，操作会按键盘的按键重复速度重复执行。"
          }
        }
      }
    },
    "holdOutputShortcutHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kürzel bleibt gedrückt, solange Sie den Auslöser gedrückt halten, und wiederholt sich wie eine gehaltene Taste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shortcut stays pressed for as long as you hold the trigger and repeats like a held key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El atajo sigue pulsado mientras mantienes pulsado el activador y se repite como una tecla mantenida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci reste enfoncé tant que vous maintenez le déclencheur et se répète comme une touche maintenue."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетание остаётся нажатым, пока вы удерживаете триггер, и повторяется как зажатая клавиша."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住触发器期间，快捷键保持按下，并像按住按键一样重复。"
          }
        }
      }
