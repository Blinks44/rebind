    "holdHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird einmal ausgelöst, wenn Sie so lange gedrückt halten. Kürzeres Drücken bewirkt nichts und wird nicht weitergegeben. Loslassen, eine andere Taste oder Scrollen bricht ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs once after you hold for the chosen time. A shorter press does nothing and is not passed on. Releasing, pressing something else or scrolling cancels it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’exécute une fois lorsque vous maintenez l’appui pendant la durée choisie. Un appui plus court ne fait rien et n’est pas transmis. Relâcher, appuyer ailleurs ou faire défiler annule l’action."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срабатывает один раз, когда вы удерживаете нажатие выбранное время. Более короткое нажатие ничего не делает и не передаётся приложениям. Если отпустить, нажать что-то ещё или прокрутить, действие отменится."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta una vez cuando mantienes pulsado el tiempo elegido. Una pulsación más corta no hace nada y no se transmite. Soltar, pulsar otra cosa o desplazarte la cancela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
