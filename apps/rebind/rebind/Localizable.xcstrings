    "magicMouseSubtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what each tap, click or scroll does."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите действия для касаний, нажатий и прокрутки."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktionen für Tippen, Klicken und Scrollen wählen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les actions des touchers, clics et défilements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué hace cada toque, clic o desplazamiento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择轻点、点按和滚动的作用。"
          }
        }
      }
    },
    "magicMouseTapHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap lightly, then lift all fingers. Keep the mouse still and do not press it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слегка коснитесь поверхности и уберите все пальцы. Не двигайте мышь и не нажимайте на неё."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leicht tippen und alle Finger anheben. Die Maus dabei weder bewegen noch drücken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez légèrement, puis levez tous les doigts. Ne déplacez pas la souris et ne cliquez pas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca suavemente y levanta todos los dedos. No muevas el ratón ni lo pulses."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻触后抬起所有手指。保持鼠标静止，不要按下鼠标。"
          }
        }
      }
    },
    "magicMouseTwoFingerConflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two-finger double tap opens Mission Control. Turn it off in macOS Mouse settings to avoid both actions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двойное касание двумя пальцами открывает Mission Control. Отключите его в настройках мыши macOS, чтобы не срабатывали оба действия."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen mit zwei Fingern öffnet Mission Control. Schalten Sie es in den macOS-Mauseinstellungen aus, damit nicht beide Aktionen ausgelöst werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le double toucher avec deux doigts ouvre Mission Control. Désactivez-le dans les réglages Souris de macOS pour éviter les doubles actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El doble toque con dos dedos abre Mission Control. Desactívalo en los ajustes de Ratón de macOS para que no se ejecuten ambas acciones."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双指连点两下会打开调度中心。请在 macOS 鼠标设置中将其关闭，以免同时触发两个操作。"
          }
        }
      }
    },
