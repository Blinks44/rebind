    "namedShortcutHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet %@, das Standardkürzel von macOS für diesen Befehl. Die Aktion funktioniert möglicherweise nicht, wenn die App ein anderes Kürzel verwendet oder Sie es in den Systemeinstellungen geändert haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends %@, the standard macOS shortcut for this command. The action may not work if the app uses another shortcut or you changed it in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía %@, el atajo estándar de macOS para este comando. Puede que la acción no funcione si la app usa otro atajo o lo has cambiado en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie %@, le raccourci standard de macOS pour cette commande. L’action peut ne pas fonctionner si l’app utilise un autre raccourci ou si vous l’avez modifié dans Réglages Système."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет %@, стандартное сочетание macOS для этой команды. Действие может не сработать, если приложение использует другое сочетание или вы изменили его в Системных настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送 %@，即 macOS 中此命令的标准快捷键。如果 App 使用其他快捷键，或你在“系统设置”中更改过该快捷键，此操作可能无效。"
          }
        }
      }
    },
