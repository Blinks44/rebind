    "magicMouseClickHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press the mouse while three fingers rest on its surface. The action replaces that click."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите три пальца на поверхность мыши и нажмите на неё. Действие заменит это нажатие."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie die Maus, während drei Finger auf ihrer Oberfläche liegen. Die Aktion ersetzt diesen Klick."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez trois doigts sur la souris, puis cliquez. L’action remplace ce clic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya tres dedos en la superficie del ratón y haz clic. La acción sustituye ese clic."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将三根手指放在鼠标表面，再按下鼠标。操作会取代此次点按。"
          }
        }
      }
    },
    "magicMouseScrollHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move two fingers in the chosen direction. Each recognized stroke runs the action once instead of scrolling. If the start of a stroke is not recognized, it scrolls as usual. Direction follows your fingers, regardless of Natural Scrolling."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите двумя пальцами в выбранном направлении. Каждый распознанный жест выполняет действие один раз вместо прокрутки. Если начало жеста не распознано, прокрутка работает как обычно. Направление определяется движением пальцев и не зависит от «Естественной прокрутки»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen Sie zwei Finger in die gewählte Richtung. Jede erkannte Bewegung löst die Aktion einmal aus, statt zu scrollen. Wird der Beginn nicht erkannt, wird normal gescrollt. Die Richtung folgt Ihren Fingern, unabhängig von „Natürliches Scrollen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez deux doigts dans la direction choisie. Chaque geste reconnu exécute l’action une fois au lieu de faire défiler. Si le début n’est pas reconnu, le défilement reste normal. La direction suit vos doigts, indépendamment du défilement naturel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve dos dedos en la dirección elegida. Cada gesto reconocido ejecuta la acción una vez en lugar de desplazar. Si no se reconoce el inicio, se desplaza con normalidad. La dirección sigue tus dedos, independientemente del desplazamiento natural."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用双指向所选方向移动。每个识别到的手势会执行一次操作，取代滚动。若未能识别起始动作，则照常滚动。方向以手指移动为准，不受“自然滚动”影响。"
          }
        }
      }
    },
