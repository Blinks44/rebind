    "brightnessActionHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet die System-Helligkeitstaste. macOS bestimmt, welches Display reagiert; Displays ohne Helligkeitssteuerung ignorieren sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends the system brightness key. macOS decides which display responds; displays without brightness control ignore it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie la touche système de luminosité. macOS choisit l’écran concerné ; les écrans sans réglage de luminosité l’ignorent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имитирует нажатие клавиши яркости. macOS выбирает, какой дисплей отреагирует. На дисплеях без управления яркостью действие не сработает."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía la tecla de brillo del sistema. macOS decide qué pantalla responde; las pantallas sin control de brillo la ignoran."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送系统亮度键。由 macOS 决定哪个显示器响应；不支持亮度调节的显示器会忽略它。"
          }
        }
      }
    },
