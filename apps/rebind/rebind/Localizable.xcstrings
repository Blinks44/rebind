    "pauseRebindHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert alle Belegungen. Während der Pause laufen keine Belegungen; setzen Sie sie daher über das Rebind-Menü oder -Fenster fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses all bindings. Bindings do not run while paused, so resume from the Rebind menu or window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa todas las reglas. Mientras está en pausa no se ejecutan, así que reanuda desde el menú o la ventana de Rebind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspend toutes les règles. Elles ne s’exécutent pas pendant la pause : reprenez depuis le menu ou la fenêtre de Rebind."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостанавливает все правила. На паузе правила не работают, поэтому возобновить можно только из меню или окна Rebind."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停所有规则。暂停期间规则不会运行，请从 Rebind 菜单或窗口恢复。"
          }
        }
      }
    },
