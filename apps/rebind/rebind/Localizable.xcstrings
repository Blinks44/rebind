    "storageUnreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind konnte seine Konfigurationsdatei nicht lesen; zum Schutz der Datei ist das Bearbeiten gesperrt. Prüfen Sie ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind could not read its configuration file, so editing is locked to protect it. Check ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind n’a pas pu lire son fichier de configuration ; la modification est verrouillée pour le protéger. Vérifiez ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind не смог прочитать файл конфигурации, поэтому редактирование заблокировано, чтобы его не повредить. Проверьте ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind no ha podido leer su archivo de configuración, así que la edición está bloqueada para protegerlo. Revisa ~/Library/Application Support/Rebind/configuration.json."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind 无法读取配置文件，为保护该文件已锁定编辑。请检查 ~/Library/Application Support/Rebind/configuration.json。"
          }
        }
      }
    },
