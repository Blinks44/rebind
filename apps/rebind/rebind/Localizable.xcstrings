        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les profils et toutes les règles seront supprimés. Les réglages de l’app seront rétablis et les règles resteront en pause. Cette action est irréversible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
