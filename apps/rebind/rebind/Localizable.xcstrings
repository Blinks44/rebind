    "windowActionFailed" : {
      "comment" : "Active target is resolved when dispatch begins. AX acceptance does not confirm that a window closed or an animation finished.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aktion konnte für dieses Fenster nicht ausgeführt werden. Eventuell unterstützt die App dies nicht oder die Berechtigung „Bedienungshilfen“ fehlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not do this with the window. The app may not support it, or the Accessibility permission is missing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’effectuer cette action sur la fenêtre. L’app ne la prend peut-être pas en charge, ou l’autorisation Accessibilité manque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выполнить это действие с окном. Возможно, приложение его не поддерживает или нет разрешения «Универсальный доступ»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido hacer esto con la ventana. Puede que la app no lo admita o que falte el permiso de Accesibilidad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法对该窗口执行此操作。App 可能不支持，或缺少“辅助功能”权限。"
          }
        }
      }
    },
    "windowActionHint" : {
      "comment" : "Active target is resolved when dispatch begins. AX acceptance does not confirm that a window closed or an animation finished.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für die App oder das Fenster im Vordergrund. Manche Apps unterstützen das nicht; die Fenster von Rebind selbst sind ausgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the app or window in front. Some apps do not support it; Rebind’s own windows are not affected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à l’app ou à la fenêtre au premier plan. Certaines apps ne le prennent pas en charge ; les fenêtres de Rebind ne sont pas concernées."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует на приложение или окно на переднем плане. Некоторые приложения это не поддерживают; на окна самого Rebind действие не распространяется."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a la app o ventana que está en primer plano. Algunas apps no lo admiten; las ventanas de Rebind no se ven afectadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于最前面的 App 或窗口。部分 App 不支持；Rebind 自己的窗口不受影响。"
          }
        }
      }
    },
