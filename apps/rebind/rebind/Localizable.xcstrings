    "supportReportDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert Versionen, den Status der Berechtigungen und die Anzahl der Belegungen je Art. Der Bericht enthält keine Auslöser, Kürzel, Texte, App-Namen oder Dateipfade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies versions, permission status and the number of bindings of each kind. It contains no triggers, shortcuts, text, app names or file paths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia las versiones, el estado de los permisos y el número de reglas de cada tipo. No incluye activadores, atajos, texto, nombres de apps ni rutas de archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie les versions, l’état des autorisations et le nombre de règles de chaque type. Le rapport ne contient ni déclencheurs, ni raccourcis, ni texte, ni noms d’apps, ni chemins de fichiers."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копирует версии, состояние разрешений и количество правил каждого вида. В отчёте нет триггеров, сочетаний клавиш, текста, названий приложений и путей к файлам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝版本信息、权限状态以及各类规则的数量。报告不包含触发器、快捷键、文本、App 名称或文件路径。"
          }
        }
      }
    },
