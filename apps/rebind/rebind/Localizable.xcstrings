    "lockScreenHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimentell. Sperrt den Bildschirm über eine macOS-Funktion, die nach einem Systemupdate möglicherweise nicht mehr funktioniert. Entsperren Sie den Mac wie gewohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental. Locks the screen through a macOS feature that may stop working after a system update. Unlock your Mac as usual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expérimental. Verrouille l’écran via une fonction de macOS qui peut cesser de fonctionner après une mise à jour. Déverrouillez votre Mac comme d’habitude."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспериментальное действие. Блокирует экран через функцию macOS, которая после обновления системы может перестать работать. Разблокируйте Mac как обычно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental. Bloquea la pantalla mediante una función de macOS que puede dejar de funcionar tras una actualización del sistema. Desbloquea el Mac como de costumbre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实验性功能。通过 macOS 的一项功能锁定屏幕，系统更新后可能失效。请照常解锁 Mac。"
          }
        }
      }
    },
