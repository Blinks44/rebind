    "engineInterrupted" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat Rebind das Lesen der Eingaben untersagt. Prüfen Sie die Berechtigungen und aktivieren Sie die Belegungen erneut."
          }
        },
        "en" : {
          "stringUnit" : {
