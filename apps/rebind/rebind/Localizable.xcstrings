    "lightingCompanionMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendor apps can override the lighting. Quit them to control it here."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения производителя могут перехватывать управление подсветкой. Завершите их, чтобы настраивать её здесь."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hersteller-Apps können die Beleuchtung überschreiben. Beenden Sie sie, um die Beleuchtung hier zu steuern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps du fabricant peuvent remplacer l’éclairage. Quittez-les pour le régler ici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps del fabricante pueden cambiar la iluminación. Ciérralas para ajustarla aquí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厂商 App 可能会覆盖背光设置。请先退出这些 App，再在这里调整背光。"
          }
        }
      }
    },
    "allMiceDescription" : {
      "extractionState" : "manual",
      "comment" : "Description of the All mice card on the Devices page.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für alle Mäuse. Trackpads und Magic Mouse verhalten sich wie im System eingestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to every mouse. Trackpads and Magic Mouse keep the system behavior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à toutes les souris. Les trackpads et la Magic Mouse conservent le comportement du système."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует на все мыши. Трекпады и Magic Mouse работают как задано в системе."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a todos los ratones. Los trackpads y el Magic Mouse mantienen el comportamiento del sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于所有鼠标。触控板和妙控鼠标保持系统行为。"
          }
        }
      }
    },
