          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жесты трекпада выключены: правила на паузе или в профиле нет включённых правил для трекпада."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gestos del trackpad están desactivados: las reglas están en pausa o este perfil no tiene ninguna regla de trackpad activada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
