    "permissionsOtherPurpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Belegungen benötigen keinen separaten Zugriff auf die Eingabeüberwachung. Automation wird nur angefragt, wenn eine Aktion sie braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
