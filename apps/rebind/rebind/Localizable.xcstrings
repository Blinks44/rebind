    "mouseGesturesDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie eine mittlere oder zusätzliche Maustaste und bewegen Sie die Maus in eine Richtung. Die Empfindlichkeit ist fest eingestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a middle or extra mouse button and move up, down, left or right. Movement sensitivity is fixed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le bouton central ou un bouton supplémentaire et déplacez la souris dans une direction. La sensibilité est prédéfinie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте среднюю или дополнительную кнопку и двигайте мышь в нужную сторону. Чувствительность фиксированная."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el botón central o uno adicional y mueve el ratón arriba, abajo, a la izquierda o a la derecha. La sensibilidad es fija."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
