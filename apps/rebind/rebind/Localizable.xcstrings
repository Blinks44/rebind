            "value" : "Magic Mouse · %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Mouse · %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "妙控鼠标 · %@"
          }
        }
      },
      "comment" : "The single placeholder is the selected profile name."
    },
    "magicMouseExperimentalHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taps, three-finger clicks and two-finger scrolling run bindings. For one- or two-finger taps, turn off overlapping Smart Zoom and Mission Control gestures in macOS Mouse settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначайте действия касаниям, нажатию тремя пальцами и прокрутке двумя пальцами. Для касаний одним или двумя пальцами отключите совпадающие жесты смарт-масштабирования и Mission Control в настройках мыши macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippgesten, Klicks mit drei Fingern und Scrollen mit zwei Fingern lösen Belegungen aus. Deaktivieren Sie für Tippgesten mit einem oder zwei Fingern die überlappenden Gesten für intelligentes Zoomen und Mission Control in den macOS-Mauseinstellungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touchers, les clics à trois doigts et le défilement à deux doigts déclenchent les règles. Pour les touchers à un ou deux doigts, désactivez les gestes correspondants du zoom intelligent et de Mission Control dans les réglages Souris de macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los toques, los clics con tres dedos y el desplazamiento con dos dedos activan las reglas. Para los toques con uno o dos dedos, desactiva los gestos coincidentes del zoom inteligente y Mission Control en los ajustes de Ratón de macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点、三指点按和双指滚动可触发规则。使用单指或双指轻点时，请在 macOS 鼠标设置中关闭冲突的智能缩放和调度中心手势。"
          }
        }
      }
    },
    "magicMouseExperimentalTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Mouse gestures are experimental"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жесты Magic Mouse работают в экспериментальном режиме"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Mouse-Gesten sind experimentell"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gestes Magic Mouse sont expérimentaux"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gestos del Magic Mouse son experimentales"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "妙控鼠标手势为实验性功能"
          }
        }
      }
    },
    "magicMouseFailedHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnect your Magic Mouse or reopen Rebind, then try again. Your bindings stay saved."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переподключите Magic Mouse или заново откройте Rebind и попробуйте снова. Правила сохраняются."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie die Magic Mouse erneut oder öffnen Sie Rebind erneut und versuchen Sie es noch einmal. Ihre Belegungen bleiben gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnectez votre Magic Mouse ou rouvrez Rebind, puis réessayez. Vos règles restent enregistrées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectar el Magic Mouse o abre Rebind de nuevo e inténtalo otra vez. Las reglas siguen guardadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新连接妙控鼠标或退出并重新打开 Rebind，然后重试。规则已保留。"
          }
        }
      }
    },
    "magicMouseFailedTitle" : {
