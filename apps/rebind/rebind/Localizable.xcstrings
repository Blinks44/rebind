    "eventSendingPurpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen sind aktiviert. Rebind benötigt noch die Erlaubnis, Tastenkombinationen und Klicks an andere Apps zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility is on. Rebind still needs permission to send shortcuts and clicks to other apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accessibilité est activée. Rebind a encore besoin d’une autorisation pour envoyer des raccourcis et des clics aux autres apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ включён. Осталось разрешить Rebind выполнять сочетания клавиш и нажатия мыши в других приложениях."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesibilidad está activada. Rebind aún necesita permiso para enviar atajos y clics a otras apps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
