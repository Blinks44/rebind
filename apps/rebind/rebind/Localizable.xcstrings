    "excludedAppsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange eine dieser Apps im Vordergrund ist, sind die hier deaktivierten Funktionen von Rebind ausgeschaltet. Praktisch für Spiele, virtuelle Maschinen und Remote-Desktops."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While one of these apps is in front, Rebind skips what you turn off here. Useful for games, virtual machines and remote desktops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras una de estas apps está en primer plano, Rebind omite lo que desactives aquí. Útil para juegos, máquinas virtuales y escritorios remotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant qu’une de ces apps est au premier plan, Rebind ignore ce que vous désactivez ici. Pratique pour les jeux, les machines virtuelles et les bureaux à distance."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда одно из этих приложений на переднем плане, выбранные здесь функции Rebind отключаются. Полезно для игр, виртуальных машин и удалённых рабочих столов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当其中某个 App 位于前台时，Rebind 会停用你在此关闭的功能。适用于游戏、虚拟机和远程桌面。"
          }
        }
      }
    },
