    "magicMouseUnavailableHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your mouse, lift all fingers and try again. Your bindings stay saved and can still be edited."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите мышь, уберите все пальцы и попробуйте снова. Правила сохраняются, их по-прежнему можно редактировать."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie die Maus, heben Sie alle Finger an und versuchen Sie es erneut. Ihre Belegungen bleiben gespeichert und bearbeitbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez votre souris, levez tous les doigts et réessayez. Vos règles restent enregistrées et modifiables."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el ratón, levanta todos los dedos e inténtalo de nuevo. Las reglas siguen guardadas y puedes editarlas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接鼠标，抬起所有手指后重试。已保存的规则仍可编辑。"
          }
        }
      }
    },
