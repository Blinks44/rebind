    "buttonWheelHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taste erfassen und Richtung des Mausrads wählen. Taste gedrückt halten und das Mausrad drehen: Die Aktion wird bei jedem Schritt ausgeführt. Ein Klick ohne Drehen funktioniert wie gewohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record the button, then choose a wheel direction. To use the binding, hold that button and turn the wheel; it runs on every wheel step. A click without turning the wheel still works as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba el botón y elige una dirección de la rueda. Mantén pulsado ese botón y gira la rueda: la acción se ejecuta en cada paso. Un clic sin girar la rueda funciona como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le bouton, puis choisissez un sens de molette. Maintenez le bouton et tournez la molette : l’action s’exécute à chaque cran. Un clic sans tourner la molette fonctionne comme d’habitude."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите кнопку и выберите направление прокрутки. Чтобы правило сработало, удерживайте кнопку и крутите колесо: действие выполняется на каждом шаге колеса. Обычное нажатие без прокрутки работает как прежде."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制按钮，然后选择滚轮方向。使用时按住该按钮并滚动滚轮，每滚动一格执行一次。不滚动滚轮的点按仍照常生效。"
          }
        }
      }
    },
    "buttonWheelInput" : {
      "extractionState" : "manual",
