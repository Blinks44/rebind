        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connected mice, keyboards and trackpads. Rename them here for a shorter name in the battery menu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключённые мыши, клавиатуры и трекпады. Задайте короткое имя для меню заряда."
          }
        },
        "de" : {
          "stringUnit" : {
