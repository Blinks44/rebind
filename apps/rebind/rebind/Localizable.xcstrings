    "companionRunningMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Apps können Maustasten und Einstellungen steuern. Wenn Rebind nicht reagiert, beenden Sie diese Apps und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These apps may control mouse buttons and settings. If Rebind does not respond, quit them and try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces apps peuvent contrôler les boutons et réglages de la souris. Si Rebind ne réagit pas, quittez-les et réessayez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти приложения могут управлять кнопками и настройками мыши. Если Rebind не реагирует, завершите их и попробуйте снова."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas apps pueden controlar los botones y ajustes del ratón. Si Rebind no responde, ciérralas y vuelve a intentarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些 App 可能会控制鼠标按钮和设置。如果 Rebind 没有响应，请退出这些 App 后重试。"
          }
        }
      }
    },
