          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает выбранное приложение либо адрес или файл в приложении по умолчанию. Если вы переместите файл или приложение, выберите его заново."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la app seleccionada, o abre la dirección o el archivo en su app por omisión. Si mueves un archivo o una app, vuelve a elegirlo."
