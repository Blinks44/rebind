          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles actuelles ne nécessitent aucun accès séparé à la surveillance de l’entrée. L’automatisation est demandée uniquement si une action en a besoin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для текущих правил отдельный доступ к мониторингу ввода не нужен. Автоматизация запрашивается только для действий, которым она требуется."
          }
        },
        "es" : {
          "stringUnit" : {
