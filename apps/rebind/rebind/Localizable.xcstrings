    "quitApplicationFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App konnte nicht beendet werden. Prüfen Sie, ob sie läuft. Rebind selbst lässt sich nicht per Belegung beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not quit the app. Check that it is running. Rebind cannot quit itself with a binding."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de quitter l’app. Vérifiez qu’elle est ouverte. Rebind ne peut pas se quitter lui-même par une règle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось завершить приложение. Проверьте, что оно запущено. Сам Rebind правилом завершить нельзя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido salir de la app. Comprueba que está abierta. Rebind no puede cerrarse a sí mismo con una regla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法退出该 App。请确认它正在运行。Rebind 无法通过规则退出自身。"
          }
        }
      }
    },
    "quitApplicationHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet die gewählte App, wenn sie läuft, auch im Hintergrund. Die App fragt eventuell zuerst, ob Änderungen gesichert werden sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quits the selected app if it is running, even in the background. The app may ask you to save changes first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitte l’app choisie si elle est ouverte, même en arrière-plan. L’app peut d’abord vous proposer d’enregistrer vos modifications."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершает выбранное приложение, если оно запущено, даже в фоне. Приложение может сначала предложить сохранить изменения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale de la app seleccionada si está abierta, incluso en segundo plano. Puede que la app te pida antes guardar los cambios."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果所选 App 正在运行（包括在后台），则将其退出。App 可能会先询问是否保存更改。"
          }
        }
      }
    },
