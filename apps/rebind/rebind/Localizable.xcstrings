    "scrollActionHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolls three lines at the pointer position without keyboard modifiers. The app under the pointer decides how far its content moves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокручивает на три строки под указателем без клавиш-модификаторов. Насколько сдвинется содержимое, решает приложение под указателем."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollt drei Zeilen an der Zeigerposition ohne Sondertasten. Die App unter dem Zeiger bestimmt, wie weit sich der Inhalt bewegt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait défiler de trois lignes à la position du pointeur, sans touche de modification. L’app sous le pointeur décide du déplacement réel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza tres líneas en la posición del puntero, sin teclas modificadoras. La app bajo el puntero decide cuánto se mueve su contenido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在指针位置滚动三行，不带修饰键。内容实际移动多少由指针下方的 App 决定。"
          }
        }
      }
    },
