    "trackpadMultiFingerClickHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt einen Klick mit der gewählten Fingerzahl. Alle aufliegenden Finger zählen, auch wenn nur einer drückt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces a click made with the selected number of fingers. All fingers resting on the trackpad count, even if only one presses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace un clic avec le nombre de doigts choisi. Tous les doigts posés sur le trackpad comptent, même si un seul appuie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменяет нажатие с указанным числом пальцев. Учитываются все пальцы на трекпаде, даже если надавливает только один."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye un clic con el número de dedos elegido. Cuentan todos los dedos apoyados en el trackpad, aunque solo uno presione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取代使用所选手指数进行的点按。即使只有一根手指按下，放在触控板上的所有手指都会计入。"
          }
        }
      }
    },
