    "advancedDiagnosticsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maustasten und Scrollen prüfen. Die Aufzeichnung bleibt im Speicher und endet nach 60 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspect mouse buttons and scroll events. Recording stays in memory and stops after 60 seconds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les boutons et le défilement. L’enregistrement reste en mémoire et s’arrête après 60 secondes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка кнопок мыши и прокрутки. Запись хранится в памяти и длится не более 60 секунд."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba los botones del ratón y el desplazamiento. La grabación se guarda en memoria y se detiene a los 60 segundos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查鼠标按钮和滚动事件。录制内容仅保存在内存中，60 秒后停止。"
          }
        }
      }
    },
    "advancedDiagnosticsEmpty" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Ereignisse aufgezeichnet"
          }
        },
        "en" : {
