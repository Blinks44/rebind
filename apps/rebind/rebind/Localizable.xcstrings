    "backgroundDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind läuft weiter, wenn Sie dieses Fenster schließen. Öffnen Sie es über „Programme“ oder Spotlight, um Belegungen zu verwalten oder zu pausieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind keeps running after you close this window. Reopen it from Applications or Spotlight to manage or pause bindings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind continue de fonctionner lorsque vous fermez cette fenêtre. Rouvrez-le depuis Applications ou Spotlight pour gérer les règles ou les mettre en pause."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После закрытия окна Rebind продолжает работать. Откройте его из папки «Программы» или через Spotlight, чтобы настроить или приостановить правила."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind sigue funcionando al cerrar esta ventana. Vuelve a abrirlo desde Aplicaciones o Spotlight para gestionar las reglas o ponerlas en pausa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此窗口后，Rebind 仍会运行。可从“应用程序”或“聚焦”重新打开，以管理或暂停规则。"
          }
        }
      }
    },
    "backgroundHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
