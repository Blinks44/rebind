    "insertTextEncodingTooLong" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This text exceeds the input limit. Shorten it and try again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот текст превышает допустимый объём ввода. Сократите его и попробуйте снова."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Text überschreitet die Eingabegrenze. Kürzen Sie ihn und versuchen Sie es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce texte dépasse la limite de saisie. Raccourcissez-le et réessayez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto supera el límite de entrada. Acórtalo e inténtalo de nuevo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文本超出输入限制。请缩短后重试。"
          }
        }
      }
    },
    "bluetoothBatteryRestricted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth access is restricted on this Mac. Battery levels remain available from other supported sources."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к Bluetooth на этом Mac ограничен. Заряд по-прежнему можно получать другими поддерживаемыми способами."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bluetooth-Zugriff ist auf diesem Mac eingeschränkt. Batteriestände aus anderen unterstützten Quellen bleiben verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au Bluetooth est restreint sur ce Mac. Le niveau de batterie reste disponible via les autres sources prises en charge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a Bluetooth está restringido en este Mac. Los niveles de batería siguen disponibles a través de otras fuentes compatibles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 的蓝牙访问受到限制。仍可通过其他受支持的来源获取电量。"
          }
        }
      }
    },
    "bluetoothBatteryDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Bluetooth access to see battery levels for connected Bluetooth mice, keyboards and trackpads. Some devices do not provide this information."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к Bluetooth, чтобы видеть заряд подключённых мышей, клавиатур и трекпадов. Некоторые устройства не передают эту информацию."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie den Bluetooth-Zugriff, um den Ladestand verbundener Bluetooth-Mäuse, -Tastaturen und -Trackpads anzuzeigen. Nicht alle Geräte stellen ihn bereit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès Bluetooth pour afficher le niveau de batterie des souris, claviers et trackpads Bluetooth connectés. Certains appareils ne fournissent pas cette information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Bluetooth para ver el nivel de batería de ratones, teclados y trackpads Bluetooth conectados. Algunos dispositivos no proporcionan este dato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问蓝牙，以读取已连接鼠标、键盘和触控板的电量。部分设备不提供电量信息。"
          }
        }
      }
    },
    "bluetoothBatterySettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Bluetooth Privacy Settings"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть настройки доступа к Bluetooth"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-Datenschutz öffnen"
          }
        },
