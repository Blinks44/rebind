          }
        }
      }
    },
    "audioActionHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Lautstärke des aktuellen Audioausgabegeräts in kleinen Schritten. Die Stummschaltung bleibt dabei erhalten. Manche Geräte erlauben weder Lautstärkeregelung noch Stummschaltung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes the volume of the current sound output in small steps. Muted sound stays muted. Some outputs do not allow volume or mute control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie le volume de la sortie audio actuelle par petits paliers. Si le son est coupé, il le reste. Certaines sorties ne permettent pas de régler le volume ni de couper le son."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет громкость текущего устройства вывода небольшими шагами. Если звук выключен, он остаётся выключенным. Некоторые устройства не позволяют менять громкость или выключать звук."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el volumen de la salida de sonido actual en pasos pequeños. Si el sonido está silenciado, sigue silenciado. Algunas salidas no permiten controlar el volumen ni silenciar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以较小的幅度调整当前声音输出的音量。静音状态保持不变。部分输出设备不支持调节音量或静音。"
          }
        }
      }
    },
