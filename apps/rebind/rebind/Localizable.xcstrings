    "switchProfileHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt zum benachbarten Profil in der Liste und beginnt am Ende wieder von vorn. Legen Sie dieselbe Belegung in jedem Profil an, damit der Wechsel weiter funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches to the neighboring profile in the list and wraps around at the end. Add the same binding to each profile to keep switching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia al perfil vecino de la lista y vuelve al principio al llegar al final. Añade la misma regla a cada perfil para seguir cambiando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe au profil voisin dans la liste et revient au début après le dernier. Ajoutez la même règle à chaque profil pour continuer à changer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключает на соседний профиль в списке, с конца переходит в начало. Чтобы переключаться дальше, добавьте такое же правило в каждый профиль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换到列表中相邻的配置文件，到末尾后回到开头。要继续切换，请在每个配置文件中添加同样的规则。"
          }
        }
      }
    },
