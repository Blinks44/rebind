    "advancedDiagnosticsLimits" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endet nach 60 Sekunden. Bis zu 128 Ereignisse, höchstens 20 pro Sekunde. Beim Schließen wird die Aufzeichnung gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops after 60 seconds. Keeps up to 128 events, at most 20 per second. Closing clears the recording."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’arrête après 60 secondes. Jusqu’à 128 événements, 20 par seconde au maximum. La fermeture efface l’enregistrement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливается через 60 секунд. До 128 событий, не более 20 в секунду. При закрытии запись удаляется."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene a los 60 segundos. Guarda hasta 128 eventos, como máximo 20 por segundo. Al cerrar se borra la grabación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 秒后停止。最多保留 128 个事件，每秒不超过 20 个。关闭窗口会清除录制内容。"
          }
        }
      }
    },
    "advancedDiagnosticsPrivacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur Maustasten und Scrollen. Eingegebener Text und Gerätedetails werden nie aufgezeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows only mouse buttons and scrolling. Typed text and device details are never recorded."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche uniquement les boutons de la souris et le défilement. Le texte saisi et les détails des appareils ne sont jamais enregistrés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает только кнопки мыши и прокрутку. Набранный текст и сведения об устройствах не записываются."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo muestra los botones del ratón y el desplazamiento. Nunca se registran el texto escrito ni los datos de los dispositivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只显示鼠标按钮和滚动。绝不记录输入的文字和设备信息。"
          }
        }
      }
    },
