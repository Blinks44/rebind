    "recordingLimitations" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie die Taste oder das Kürzel, das Sie verwenden möchten. Feststelltaste, Fn und einzelne Sondertasten werden nicht unterstützt. Esc bricht ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press the key or shortcut you want to use. Caps Lock, Fn and modifier keys on their own are not supported. Escape cancels."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur la touche ou le raccourci à utiliser. Verr. Maj, Fn et les touches de modification seules ne sont pas prises en charge. Échap annule."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите клавишу или сочетание, которое хотите использовать. Caps Lock, Fn и одиночные клавиши-модификаторы не поддерживаются. Escape отменяет запись."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa la tecla o el atajo que quieras usar. No se admiten Bloq Mayús, Fn ni las teclas modificadoras por sí solas. Escape cancela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下要使用的按键或快捷键。不支持大写锁定键、Fn 以及单独的修饰键。按 Escape 取消。"
          }
        }
      }
    },
