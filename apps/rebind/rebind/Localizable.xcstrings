        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt keine Rebind-Aktion aus. Tasten und Maustasten werden blockiert; macOS kann auf Touch-Gesten weiterhin reagieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
