    "accessibilityPurpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Rebind, Ihre Auslöser zu erkennen und die gewählten Aktionen in anderen Apps auszuführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Rebind to recognize your triggers and perform the actions you choose in other apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Rebind à reconnaître vos déclencheurs et à exécuter les actions choisies dans les autres apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Rebind распознавать нажатия и жесты и выполнять выбранные действия в других приложениях."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Rebind reconozca tus activadores y realice en otras apps las acciones que elijas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Rebind 识别你的触发器，并在其他 App 中执行你选择的操作。"
          }
        }
      }
    },
    "accessibilitySteps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie Rebind unter Datenschutz & Sicherheit → Bedienungshilfen. Kehren Sie dann hierher zurück, um den Zugriff zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Privacy & Security → Accessibility, turn on Rebind. Return here to check access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Rebind dans Confidentialité et sécurité → Accessibilité. Revenez ici pour vérifier l’accès."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В разделе «Конфиденциальность и безопасность» → «Универсальный доступ» включите Rebind. Вернитесь сюда, чтобы проверить доступ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Privacidad y seguridad → Accesibilidad, activa Rebind. Vuelve aquí para comprobar el acceso."
