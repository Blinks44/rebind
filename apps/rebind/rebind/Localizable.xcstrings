    "eventSendingSteps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls der Zugriff weiterhin fehlt, prüfen Sie Rebind unter „Bedienungshilfen“. Beenden und öffnen Sie Rebind erneut, wenn macOS Sie dazu auffordert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If access stays unavailable, check Rebind in Accessibility. Quit and reopen Rebind if macOS asks you to."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’accès reste indisponible, vérifiez Rebind dans Accessibilité. Quittez puis rouvrez Rebind si macOS vous le demande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если доступ так и не появился, проверьте Rebind в разделе «Универсальный доступ». Если macOS попросит, закройте и снова откройте Rebind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el acceso sigue sin estar disponible, comprueba Rebind en Accesibilidad. Cierra y vuelve a abrir Rebind si macOS te lo pide."
