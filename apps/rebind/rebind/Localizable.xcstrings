    "activateApplicationHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt nur zur App, wenn sie bereits läuft; sie wird nicht gestartet. Wählen Sie die App erneut aus, wenn Sie sie verschoben haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches to the app only if it is already running; it is not launched. If you move the app, choose it again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bascule vers l’app uniquement si elle est déjà ouverte ; elle n’est pas lancée. Si vous déplacez l’app, choisissez-la de nouveau."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключает на приложение, только если оно уже запущено; само приложение не запускается. Если вы переместите приложение, выберите его заново."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia a la app solo si ya está abierta; no la inicia. Si mueves la app, vuelve a elegirla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当 App 已在运行时才切换过去，不会启动它。如果移动了 App，请重新选择。"
          }
        }
      }
    },
