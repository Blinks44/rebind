    "mousePointerHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taste erfassen und Richtung wählen. Taste gedrückt halten und die Maus bewegen: Die Aktion wird einmal pro Halten ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record the button, then choose a direction. To use the binding, hold that button and move the pointer. It runs once per hold."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le bouton, puis choisissez une direction. Maintenez-le et déplacez la souris : une action par maintien."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите кнопку и выберите направление. Удерживайте её и двигайте мышь: действие сработает один раз за удержание."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba el botón y elige una dirección. Para usar la regla, mantén pulsado ese botón y mueve el puntero. Se ejecuta una vez por pulsación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制按钮，然后选择方向。使用时按住该按钮并移动指针。每次按住只执行一次。"
          }
        }
      }
    },
