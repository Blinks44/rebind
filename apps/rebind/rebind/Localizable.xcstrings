    "recordingLimitations" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie die Taste oder das Kürzel, das Sie verwenden möchten. Feststelltaste, Fn und einzelne Sondertasten werden nicht unterstützt. Esc bricht ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
