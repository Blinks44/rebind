    "openTargetHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die gewählte App oder die Adresse bzw. Datei in ihrer Standard-App. Wählen Sie verschobene Dateien und Apps erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
