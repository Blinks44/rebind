    "trackpadTapHint" : {
      "comment" : "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen schaltet macOS-Gesten nicht aus, daher kann beides ausgelöst werden. Belegungen für Ecken und Klicks ersetzen den Klick selbst. Gibt es eine Doppeltipp-Belegung, wartet das einfache Tippen kurz, ob ein zweites folgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taps do not turn off macOS gestures, so both may run. Corner and click bindings replace the click itself. With a double-tap binding, the single tap waits a moment to see whether a second tap follows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touchers ne désactivent pas les gestes de macOS : les deux peuvent se déclencher. Les règles de coin et de clic remplacent le clic lui-même. Avec une règle de double toucher, le toucher simple attend un instant un éventuel second toucher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Касания не отключают жесты macOS, поэтому могут сработать оба. Правила для углов и нажатий заменяют само нажатие. Если есть правило на двойное касание, одиночное срабатывает с небольшой задержкой: Rebind ждёт второго касания."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los toques no desactivan los gestos de macOS, así que pueden ejecutarse ambos. Las reglas de esquina y de clic sustituyen al propio clic. Con una regla de doble toque, el toque simple espera un instante por si llega un segundo toque."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点不会关闭 macOS 手势，因此两者可能同时触发。角落和点按规则会取代点按本身。如果设有轻点两下的规则，单次轻点会稍等片刻，看是否还有第二次轻点。"
          }
        }
      }
    },
    "trackpadTapToClickHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist „Klick durch Tippen“ aktiviert, löst Tippen in dieser Ecke die Belegung aus, statt zu klicken; drücken Sie das Trackpad, um dort zu klicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Tap to click on, a tap in this corner runs the binding instead of clicking; press the trackpad to click there."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si « Toucher pour cliquer » est activé, un toucher dans ce coin exécute la règle au lieu de cliquer ; appuyez sur le trackpad pour y cliquer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено «Касание для имитации нажатия», касание в этом углу запускает правило вместо нажатия. Чтобы нажать в этом месте, надавите на трекпад."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “Tocar para hacer clic” activado, un toque en esta esquina ejecuta la regla en lugar de hacer clic; pulsa el trackpad para hacer clic ahí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“轻点来点按”后，在这个角落轻点会执行规则而不是点按；要在此处点按，请按下触控板。"
          }
        }
      }
    },
    "trackpadThreeFingerClick" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klick · 3 Finger"
          }
        },
