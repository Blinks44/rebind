    "pressTimingDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltedauer für Tasten: 100–5.000 ms. Doppeltes Drücken richtet sich nach der Doppelklickgeschwindigkeit von macOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold time for keys and buttons: 100–5,000 ms. Double presses use the macOS double-click speed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la durée de maintien : 100–5 000 ms. Le double appui utilise la vitesse du double-clic de macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время удержания клавиш и кнопок: 100–5 000 мс. Скорость двойного нажатия берётся из настроек двойного щелчка в macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de pulsación mantenida de teclas y botones: de 100 a 5000 ms. La doble pulsación usa la velocidad de doble clic de macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按键和按钮的按住时长：100–5000 毫秒。按两下的间隔采用 macOS 的双击速度。"
          }
        }
      }
    },
