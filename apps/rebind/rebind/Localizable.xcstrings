    "trackpadZoomHelp" : {
      "comment" : "Trackpad preset editor. Conditional guidance does not inspect or change macOS settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Zoomen per Trackpad-Geste aktiviert ist, reagiert macOS ebenfalls. Prüfen Sie das unter Systemeinstellungen → Bedienungshilfen → Zoomen oder wählen Sie eine andere Geste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If zooming with a trackpad gesture is on, macOS responds as well. Review it in System Settings → Accessibility → Zoom, or choose another gesture."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le zoom par geste du trackpad est activé, macOS réagit aussi. Vérifiez-le dans Réglages Système → Accessibilité → Zoom, ou choisissez un autre geste."
          }
        },
        "ru" : {
          "stringUnit" : {
