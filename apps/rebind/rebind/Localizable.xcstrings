    "permissionsAccessibilityEnabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind kann Auslöser erkennen und gewählte Aktionen in anderen Apps ausführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind can recognize triggers and perform your chosen actions in other apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind peut reconnaître les déclencheurs et exécuter les actions choisies dans les autres apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebind может распознавать нажатия и жесты и выполнять выбранные действия в других приложениях."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
