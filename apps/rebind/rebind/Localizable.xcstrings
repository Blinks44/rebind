    "eventPostingRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen sind erlaubt, aber Rebind kann noch keine Tastenkombinationen und Klicks senden. Klicken Sie im Hauptfenster auf „Senden von Ereignissen erlauben“ und starten Sie Rebind bei Aufforderung neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility is allowed, but Rebind still cannot send shortcuts and clicks. Choose Allow Event Sending in the main window and reopen Rebind if macOS asks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accessibilité est autorisée, mais Rebind ne peut pas encore envoyer de raccourcis ni de clics. Cliquez sur « Autoriser l’envoi d’événements » dans la fenêtre principale, puis relancez Rebind si macOS le demande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ разрешён, но Rebind пока не может выполнять сочетания клавиш и нажатия мыши. Нажмите «Разрешить отправку событий» в главном окне и перезапустите Rebind, если macOS попросит."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesibilidad está permitida, pero Rebind aún no puede enviar atajos ni clics. Elige Permitir el envío de eventos en la ventana principal y vuelve a abrir Rebind si macOS lo pide."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已允许辅助功能，但 Rebind 仍无法发送快捷键和点按。请在主窗口中选择“允许发送事件”，如果 macOS 提示，请重新打开 Rebind。"
          }
        }
      }
    },
    "eventPostingStatus" : {
