          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ejecuta ninguna acción de Rebind. Bloquea teclas y botones; macOS puede seguir respondiendo a los gestos táctiles."
          }
        },
        "fr" : {
          "stringUnit" : {
