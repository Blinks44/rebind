    "doublePressHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie zweimal schnell, wie bei einem Doppelklick. Ein einzelnes Drücken bewirkt nichts und wird nicht weitergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press twice quickly, as for a double-click. A single press does nothing and is not passed on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez deux fois rapidement, comme pour un double-clic. Un appui simple ne fait rien et n’est pas transmis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите дважды быстро, как при двойном щелчке. Одиночное нажатие ничего не делает и не передаётся приложениям."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa dos veces rápidamente, como en un doble clic. Una sola pulsación no hace nada y no se transmite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像双击那样快速按两下。只按一下不会有任何作用，也不会传给其他 App。"
          }
        }
      }
    },
