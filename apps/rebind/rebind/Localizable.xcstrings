    "emergencyHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notfallpause: ⌃⌥⇧⌘ Escape. Auch über die Menüleiste pausierbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emergency pause: ⌃⌥⇧⌘ Escape. You can also pause from the menu bar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause d’urgence : ⌃⌥⇧⌘ Échap. Également disponible dans la barre des menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аварийная пауза: ⌃⌥⇧⌘ Escape. Также можно приостановить правила через строку меню."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa de emergencia: ⌃⌥⇧⌘ Escape. También puedes pausar desde la barra de menús."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
