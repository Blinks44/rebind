    "magicMouseEditorScope %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Mouse · %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Mouse · %@"
          }
        },
        "de" : {
          "stringUnit" : {
