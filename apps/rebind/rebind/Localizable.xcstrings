    "magicMouseOneFingerConflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-finger double tap activates Smart Zoom. Turn it off in macOS Mouse settings to avoid both actions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двойное касание одним пальцем запускает смарт-масштабирование. Отключите его в настройках мыши macOS, чтобы не срабатывали оба действия."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen mit einem Finger aktiviert intelligentes Zoomen. Schalten Sie es in den macOS-Mauseinstellungen aus, damit nicht beide Aktionen ausgelöst werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le double toucher avec un doigt active le zoom intelligent. Désactivez-le dans les réglages Souris de macOS pour éviter les doubles actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El doble toque con un dedo activa el zoom inteligente. Desactívalo en los ajustes de Ratón de macOS para que no se ejecuten ambas acciones."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单指连点两下会触发智能缩放。请在 macOS 鼠标设置中将其关闭，以免同时触发两个操作。"
          }
        }
      }
    },
    "magicMouseOneFingerTap" : {
