    "otherPermissionsPurpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für aktuelle Belegungen ist kein zusätzlicher Zugriff nötig. Automation wird nur angefragt, wenn eine Aktion sie braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No separate access is needed for current bindings. Automation is requested only if an action needs it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun accès supplémentaire n’est nécessaire pour les règles actuelles. L’autorisation d’automatisation est demandée uniquement si une action en a besoin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для текущих правил отдельный доступ не нужен. Разрешение на автоматизацию запрашивается только для действий, которым оно требуется."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas actuales no necesitan ningún acceso adicional. La automatización solo se solicita si una acción la necesita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前规则不需要额外的权限。只有操作需要时才会请求自动化权限。"
          }
        }
      }
    },
