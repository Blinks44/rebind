# Repository policy: keep source, manifests/lockfiles, shared configuration,
# design inputs, docs/tasks/evidence, AGENTS.md and .agents/skills versioned.
# Exclude only reproducible output and workstation-local state.

# macOS filesystem metadata
.DS_Store
.AppleDouble
._*

# Xcode build products and intermediates (including standalone tool output)
DerivedData/
build/
Build/
*.xcarchive/
*.dSYM/
*.hmap

# Xcode transient verification output; concise technical results stay in docs.
*.xcresult/

# Generated raster captures belong in .local/agent-context/verification/.
# Scope this to verification output; app/brand assets and test fixtures stay visible.
# A justified versioned image needs a documented purpose and a narrow exception here.
/docs/verification/**/*.png
/docs/verification/**/*.jpg
/docs/verification/**/*.jpeg

# Xcode per-user state; keep xcshareddata and shared schemes.
*.xcuserstate
xcuserdata/

# JetBrains local project/workspace state; Rebind has no shared .idea contract.
.idea/

# Agent-local transcripts, scratch work, backups and workstation access hints.
# Verification screenshots/exports use .local/agent-context/verification/ by default.
# Shared agent instructions, skills, state, tasks and evidence remain versioned.
/.local/agent-context/

# Swift Package Manager
.build/
# Cache/security state can exist at the root or in a standalone package.
**/.swiftpm/cache/
**/.swiftpm/security/

# Package.swift and Package.resolved remain versioned; never ignore .swiftpm wholesale.
